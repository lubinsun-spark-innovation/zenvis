#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

WORKSPACE_ROOT=${LUBINSUN_WORKSPACE_ROOT:-/home/lubinsun/lubinsun}
STATE_ROOT=${LUBINSUN_DEPLOY_STATE_ROOT:-/home/lubinsun/.local/state/lubinsun-deploy}
LOCK_FILE="$STATE_ROOT/deploy.lock"
ZENVIS_REPO="$WORKSPACE_ROOT/zenvis"
ZENVIS_ENV="$ZENVIS_REPO/deploy/.env"
ZENVIS_IMAGE_ENV="$STATE_ROOT/shared/zenvis-images.env"
ZENVIS_SOURCE_ENV="$STATE_ROOT/shared/zenvis-source.env"
ZENVIS_RELEASE_HEAD="$STATE_ROOT/shared/zenvis-release-head.env"
AGENT_REPO="$WORKSPACE_ROOT/lubinsun_agent"
AGENT_ENV="$AGENT_REPO/.env.local.docker"
AGENT_IMAGE_ENV="$STATE_ROOT/shared/agent-images.env"
AGENT_RUNTIME_ENV="$STATE_ROOT/shared/agent-runtime.env"
AGENT_SOURCE_ENV="$STATE_ROOT/shared/agent-source.env"
ANALYZER_REPO="$WORKSPACE_ROOT/zenvis-service-analyzer"
ANALYZER_ENV="$ANALYZER_REPO/deploy/topology.env"
ANALYZER_IMAGE_ENV="$STATE_ROOT/shared/analyzer-images.env"
ANALYZER_SOURCE_ENV="$STATE_ROOT/shared/analyzer-source.env"
ANALYZER_COMPOSE_OVERRIDE="$STATE_ROOT/shared/analyzer-compose.override.yml"
ANALYZER_ZONE_FILE="$STATE_ROOT/shared/analyzer-zones.json"
MIN_MEMORY_KIB=${LUBINSUN_MIN_MEMORY_KIB:-14680064}
MIN_SWAP_KIB=${LUBINSUN_MIN_SWAP_KIB:-2097152}
MIN_DISK_KIB=${LUBINSUN_MIN_DISK_KIB:-20971520}
HEALTH_ATTEMPTS=${LUBINSUN_HEALTH_ATTEMPTS:-90}
MAVEN_BUILDER_IMAGE=${LUBINSUN_MAVEN_BUILDER_IMAGE:-maven:3.9.11-eclipse-temurin-17}
HOST_MAVEN_BIN=${LUBINSUN_HOST_MAVEN_BIN:-/home/lubinsun/.local/lib/apache-maven-3.9.11/bin/mvn}
HOST_JAVA_HOME=${LUBINSUN_HOST_JAVA_HOME:-/home/lubinsun/.local/jvm/temurin-17}
NODE_BUILDER_IMAGE=${LUBINSUN_NODE_BUILDER_IMAGE:-node:22-bookworm}
HOST_NODE_HOME=${LUBINSUN_HOST_NODE_HOME:-/home/lubinsun/.nvm/versions/node/v24.15.0}
GO_PROXY=${LUBINSUN_GO_PROXY:-https://goproxy.cn,direct}
BACKEND_SAFE_TEST_PATTERN=${LUBINSUN_BACKEND_SAFE_TEST_PATTERN:-*,!McpChatToolGrantPersistenceTest,!ClickhouseTableTtlIntegrationTest,!ClickhouseRecordIdMigrationIntegrationTest,!WebServiceApplicationTests,!MenuTest,!PluginUpgradeUiConfigTest,!SkillServiceTest,!DataInitiatorDashboardTest,!ReportExportServiceTest}

log() {
  printf '[%s] %s\n' "$(date -Is)" "$*"
}

cleanup_pending_agent_migrations() {
  local pending=${PENDING_MIGRATION_MANIFEST:-}
  [[ -n "$pending" ]] || return 0
  [[ "$(dirname -- "$pending")" == "$STATE_ROOT/components/lubinsun-agent" ]] || return 0
  [[ "$(basename -- "$pending")" == pending-migrations.* ]] || return 0
  rm -f -- "$pending"
  unset PENDING_MIGRATION_MANIFEST
}

die() {
  cleanup_pending_agent_migrations
  log "错误：$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "缺少命令：$1"
}

usage() {
  cat <<'USAGE'
Lubinsun 统一部署控制器

用法：
  lubinsun-deploy doctor
  lubinsun-deploy status
  lubinsun-deploy verify <component|all>
  lubinsun-deploy deploy <component> <owner/repository> <40位git-sha>
  lubinsun-deploy deploy-local <component>
  lubinsun-deploy rollback <component>
  lubinsun-deploy gc [保留数量]

component:
  zenvis | zenvis-backend | zenvis-frontend | zenvis-analyzer
  lubinsun-agent

说明：
  deploy       供 GitHub Actions 使用，从 origin/main 的精确提交快照部署。
  deploy-local 从当前工作树生成隔离快照，可包含尚未提交的本地修改。
  gc           清理未被引用且校验完整的旧备份/源码快照，以及已完成的旧部署任务日志。
USAGE
}

env_value() {
  local file=$1 key=$2 line value
  [[ -f "$file" ]] || return 0
  line=$(grep -E "^[[:space:]]*${key}=" "$file" | tail -n 1 || true)
  [[ -n "$line" ]] || return 0
  value=${line#*=}
  value=${value%$'\r'}
  if [[ "$value" == \"*\" && "$value" == *\" ]]; then
    value=${value:1:${#value}-2}
  elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
    value=${value:1:${#value}-2}
  fi
  printf '%s' "$value"
}

manifest_value() {
  local file=$1 key=$2
  [[ -f "$file" ]] || return 0
  sed -n "s/^${key}=//p" "$file" | tail -n 1
}

component_config() {
  local component=$1
  COMPONENT=$component
  case "$component" in
    zenvis)
      COMPONENT_REPO="$ZENVIS_REPO"
      COMPONENT_GITHUB="lubinsun-spark-innovation/zenvis"
      ;;
    zenvis-backend)
      COMPONENT_REPO="$WORKSPACE_ROOT/zenvis-backend"
      COMPONENT_GITHUB="lubinsun-spark-innovation/zenvis-backend"
      ;;
    zenvis-frontend)
      COMPONENT_REPO="$WORKSPACE_ROOT/zenvis-frontend"
      COMPONENT_GITHUB="lubinsun-spark-innovation/zenvis-frontend"
      ;;
    zenvis-analyzer)
      COMPONENT_REPO="$ANALYZER_REPO"
      COMPONENT_GITHUB="lubinsun-spark-innovation/zenvis-service-analyzer"
      ;;
    plugin-onesoc)
      COMPONENT_REPO="$WORKSPACE_ROOT/zenvis-plugin/zenvis-plugin-onesoc"
      COMPONENT_GITHUB="lubinsun-spark-innovation/zenvis-plugin-onesoc"
      PLUGIN_PACKAGE="com.coolxer.plugin.onesoc"
      PLUGIN_DIRECTORY="plugin-onesoc"
      PLUGIN_SMOKE_PATH="/api/v1/plugin/com.coolxer.plugin.onesoc/security-operation/dashboard/overview"
      ;;
    plugin-lubinsun)
      COMPONENT_REPO="$WORKSPACE_ROOT/zenvis-plugin/zenvis-plugin-lubinsun"
      COMPONENT_GITHUB="lubinsun-spark-innovation/zenvis-plugin-lubinsun"
      PLUGIN_PACKAGE="com.coolxer.plugin.lubinsun"
      PLUGIN_DIRECTORY="plugin-lubinsun"
      PLUGIN_SMOKE_PATH="/api/v1/plugin/com.coolxer.plugin.lubinsun/connection"
      ;;
    lubinsun-agent)
      COMPONENT_REPO="$AGENT_REPO"
      COMPONENT_GITHUB="lubinsun-spark-innovation/lubinsun_agent"
      ;;
    *) die "未知 component：$component" ;;
  esac
}

check_env_file() {
  local file=$1 label=$2 mode
  [[ -f "$file" ]] || die "$label 环境文件不存在：$file"
  mode=$(stat -c '%a' "$file")
  [[ "$mode" == 600 || "$mode" == 400 ]] || die "$label 环境文件权限必须是 600 或 400，当前为 $mode"
  if grep -Eiq '(^|=)(replace-with-|change-me|REPLACE_ME|CHANGEME)' "$file"; then
    die "$label 环境文件仍含模板占位值"
  fi
}

doctor() {
  local memory_kib swap_kib disk_kib arch ntp
  for command in git docker curl jq flock tar gzip sha256sum awk sed cmp df stat sort head find id install mktemp; do need "$command"; done
  docker info >/dev/null
  docker compose version >/dev/null
  if [[ -e "$(dirname "$HOST_MAVEN_BIN")" || -e "$HOST_JAVA_HOME" ]]; then
    [[ -x "$HOST_MAVEN_BIN" && -x "$HOST_JAVA_HOME/bin/java" ]] || die "本地主机构建工具链不完整"
    JAVA_HOME="$HOST_JAVA_HOME" PATH="$HOST_JAVA_HOME/bin:$PATH" \
      "$HOST_MAVEN_BIN" --version | head -n 1 | grep -Fq 'Apache Maven 3.9.11 ' \
      || die "本地主机 Maven 版本必须是 3.9.11"
    "$HOST_JAVA_HOME/bin/java" -version 2>&1 | head -n 1 | grep -Eq '^openjdk version "17\.' \
      || die "本地主机 Java 主版本必须是 17"
  fi
  if [[ -e "$HOST_NODE_HOME" ]]; then
    [[ -x "$HOST_NODE_HOME/bin/node" && -x "$HOST_NODE_HOME/bin/corepack" ]] \
      || die "本地主机 Node 工具链不完整"
    "$HOST_NODE_HOME/bin/node" -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a > 22 || a === 22 && b >= 12 || a === 20 && b >= 19 ? 0 : 1)' \
      || die "本地主机 Node 不满足 ^20.19.0 || >=22.12.0"
    [[ "$(env -u NODE_TLS_REJECT_UNAUTHORIZED "$HOST_NODE_HOME/bin/corepack" yarn --version)" == 1.22.22 ]] \
      || die "本地主机 Yarn 版本必须是 1.22.22"
  fi
  arch=$(uname -m)
  [[ "$arch" == x86_64 || "$arch" == amd64 ]] || die "只支持 x86_64/amd64，当前为 $arch"
  memory_kib=$(awk '/^MemTotal:/ {print $2}' /proc/meminfo)
  swap_kib=$(awk '/^SwapTotal:/ {print $2}' /proc/meminfo)
  disk_kib=$(df -Pk "$WORKSPACE_ROOT" | awk 'NR==2 {print $4}')
  (( memory_kib >= MIN_MEMORY_KIB )) || die "内存不足：${memory_kib}KiB < ${MIN_MEMORY_KIB}KiB"
  (( swap_kib >= MIN_SWAP_KIB )) || die "Swap 不足：${swap_kib}KiB < ${MIN_SWAP_KIB}KiB"
  (( disk_kib >= MIN_DISK_KIB )) || die "磁盘可用空间不足：${disk_kib}KiB < ${MIN_DISK_KIB}KiB"
  if command -v timedatectl >/dev/null 2>&1; then
    ntp=$(timedatectl show -p NTPSynchronized --value 2>/dev/null || true)
    [[ "$ntp" == yes ]] || die "系统时间未与 NTP 同步"
  fi
  check_env_file "$ZENVIS_ENV" ZenVis
  check_env_file "$AGENT_ENV" Lubinsun-Agent
  check_env_file "$ANALYZER_ENV" ZenVis-Analyzer
  [[ -w "$STATE_ROOT" || ( ! -e "$STATE_ROOT" && -w "$(dirname "$STATE_ROOT")" ) ]] \
    || die "部署状态目录不可写：$STATE_ROOT"
  log "环境检查通过：arch=$arch memory=${memory_kib}KiB swap=${swap_kib}KiB disk=${disk_kib}KiB"
}

assert_clean_repo() {
  local repo=$1
  git -C "$repo" diff --quiet || die "仓库有未提交的已跟踪改动：$repo"
  git -C "$repo" diff --cached --quiet || die "仓库有已暂存改动：$repo"
  [[ -z "$(git -C "$repo" ls-files --others --exclude-standard)" ]] \
    || die "仓库有未跟踪文件：$repo"
}

component_tree_digest() {
  local repo=$1 tree=$2 component=$3 variant=${4:-all}
  local paths=()
  case "$component:$variant" in
    zenvis:*)
      paths=(deploy/docker-compose.yml deploy/docker-compose.automation.yml deploy/config
        deploy/automation zenvisctl quick-deploy.sh)
      ;;
    zenvis-backend:*)
      paths=(Dockerfile build.sh pom.xml src)
      ;;
    zenvis-frontend:*)
      paths=(Dockerfile build.sh .browserslistrc .env .env.development .env.production
        .eslintignore .eslintrc.js index.html package.json playwright.config.ts prettier.config.js
        public src tsconfig.json tsconfig.node.json vite.config.ts yarn.lock)
      ;;
    zenvis-analyzer:*)
      paths=(.dockerignore Dockerfile Makefile configs deploy go.mod go.sum internal main.go main_test.go web)
      ;;
    lubinsun-agent:backend)
      paths=(.dockerignore backend skills deploy/backend.Dockerfile deploy/executor-egress.sh)
      ;;
    lubinsun-agent:frontend)
      paths=(.dockerignore frontend deploy/frontend.Dockerfile deploy/nginx.conf)
      ;;
    lubinsun-agent:stack)
      paths=(docker-compose.yml docker-compose.tools-root.yml docker-compose.tools-diagnostic.yml
        deploy/docker-compose.production.yml)
      ;;
    plugin-lubinsun:*|plugin-onesoc:*)
      paths=(.)
      ;;
    *) die "无法计算组件部署摘要：$component/$variant" ;;
  esac
  git -C "$repo" ls-tree -r "$tree" -- "${paths[@]}" | sha256sum | awk '{print $1}'
}

set_source_metadata() {
  local repo=$1 tree=$2 revision=$3 kind=$4
  SOURCE_TREE=$tree
  SOURCE_REVISION=$revision
  SOURCE_KIND=$kind
  if [[ "$COMPONENT" == lubinsun-agent ]]; then
    AGENT_BACKEND_DIGEST=$(component_tree_digest "$repo" "$tree" "$COMPONENT" backend)
    AGENT_FRONTEND_DIGEST=$(component_tree_digest "$repo" "$tree" "$COMPONENT" frontend)
    AGENT_STACK_DIGEST=$(component_tree_digest "$repo" "$tree" "$COMPONENT" stack)
    SOURCE_DIGEST=$(printf 'backend=%s\nfrontend=%s\nstack=%s\n' \
      "$AGENT_BACKEND_DIGEST" "$AGENT_FRONTEND_DIGEST" "$AGENT_STACK_DIGEST" \
      | sha256sum | awk '{print $1}')
  else
    SOURCE_DIGEST=$(component_tree_digest "$repo" "$tree" "$COMPONENT")
  fi
}

finalize_source_snapshot() {
  local snapshot=$1
  if [[ "$COMPONENT" == zenvis ]]; then
    rm -rf "$snapshot/deploy/data" "$snapshot/deploy/open_config"
    ln -s "$ZENVIS_REPO/deploy/data" "$snapshot/deploy/data"
    ln -s "$ZENVIS_REPO/deploy/open_config" "$snapshot/deploy/open_config"
  fi
  : >"$snapshot/.snapshot-complete"
  chmod 600 "$snapshot/.snapshot-complete"
}

create_source_snapshot() {
  local repo=$1 tree=$2 snapshot temp
  snapshot="$STATE_ROOT/sources/$COMPONENT/$tree"
  if [[ -f "$snapshot/.snapshot-complete" ]]; then
    COMPONENT_SOURCE_DIR=$snapshot
    return
  fi
  mkdir -p "$STATE_ROOT/sources/$COMPONENT"
  [[ ! -e "$snapshot" ]] || die "源码快照目录不完整，请人工检查：$snapshot"
  temp=$(mktemp -d "$STATE_ROOT/sources/$COMPONENT/.snapshot.XXXXXX")
  git -C "$repo" archive "$tree" | tar -xf - -C "$temp"
  finalize_source_snapshot "$temp"
  mv "$temp" "$snapshot"
  COMPONENT_SOURCE_DIR=$snapshot
}

prepare_remote_source() {
  local repo=$1 expected_repo=$2 event_sha=$3 remote_url remote_sha remote_tree event_digest remote_digest
  [[ "$event_sha" =~ ^[0-9a-f]{40}$ ]] || die "非法 git SHA：$event_sha"
  [[ "$repo" == "$WORKSPACE_ROOT"/* ]] || die "仓库路径越界：$repo"
  [[ -d "$repo/.git" ]] || die "不是 Git 仓库：$repo"
  remote_url=$(git -C "$repo" remote get-url origin)
  [[ "$remote_url" == *"github.com/${expected_repo}.git" || "$remote_url" == *"github.com:${expected_repo}.git" ]] \
    || die "origin 与允许仓库不一致：$repo"
  git -C "$repo" fetch origin main --prune --tags
  remote_sha=$(git -C "$repo" rev-parse origin/main)
  git -C "$repo" cat-file -e "$event_sha^{commit}" 2>/dev/null || die "事件 SHA 不存在于仓库"
  if [[ "$event_sha" != "$remote_sha" ]]; then
    git -C "$repo" merge-base --is-ancestor "$event_sha" "$remote_sha" \
      || die "事件 SHA 不属于当前 origin/main：event=$event_sha remote=$remote_sha"
    if [[ "$COMPONENT" == lubinsun-agent ]]; then
      event_digest=$(printf 'backend=%s\nfrontend=%s\nstack=%s\n' \
        "$(component_tree_digest "$repo" "$event_sha^{tree}" "$COMPONENT" backend)" \
        "$(component_tree_digest "$repo" "$event_sha^{tree}" "$COMPONENT" frontend)" \
        "$(component_tree_digest "$repo" "$event_sha^{tree}" "$COMPONENT" stack)" | sha256sum | awk '{print $1}')
      remote_digest=$(printf 'backend=%s\nfrontend=%s\nstack=%s\n' \
        "$(component_tree_digest "$repo" "$remote_sha^{tree}" "$COMPONENT" backend)" \
        "$(component_tree_digest "$repo" "$remote_sha^{tree}" "$COMPONENT" frontend)" \
        "$(component_tree_digest "$repo" "$remote_sha^{tree}" "$COMPONENT" stack)" | sha256sum | awk '{print $1}')
    else
      event_digest=$(component_tree_digest "$repo" "$event_sha^{tree}" "$COMPONENT")
      remote_digest=$(component_tree_digest "$repo" "$remote_sha^{tree}" "$COMPONENT")
    fi
    if [[ "$event_digest" != "$remote_digest" ]]; then
      log "事件已被含新部署内容的 main 取代，等待较新的工作流：event=$event_sha main=$remote_sha"
      return 20
    fi
    log "main 仅有不影响部署内容的新提交，按当前 main 等价版本校验：$event_sha -> $remote_sha"
  fi
  remote_tree=$(git -C "$repo" rev-parse "$remote_sha^{tree}")
  set_source_metadata "$repo" "$remote_tree" "$remote_sha" github
  create_source_snapshot "$repo" "$SOURCE_TREE"
}

prepare_local_source() {
  local repo=$1 index tree snapshot temp
  if git -C "$repo" ls-files --others --exclude-standard \
      | awk '
          /(^|\/)\.env($|\.)/ && $0 !~ /\.example$/ { found=1 }
          /(^|\/)(id_rsa|id_ed25519|[^/]+\.(pem|p12|pfx|key))$/ { found=1 }
          END { exit(found ? 0 : 1) }
        '; then
    die "本地工作树含疑似密钥或未忽略环境文件；请先移出源码或加入 .gitignore"
  fi
  index=$(mktemp "$STATE_ROOT/local-index.XXXXXX")
  rm -f "$index"
  trap 'rm -f "${index:-}"' RETURN
  GIT_INDEX_FILE="$index" git -C "$repo" read-tree HEAD
  GIT_INDEX_FILE="$index" git -C "$repo" add -A -- .
  tree=$(GIT_INDEX_FILE="$index" git -C "$repo" write-tree)
  set_source_metadata "$repo" "$tree" "local-$tree" local
  snapshot="$STATE_ROOT/sources/$COMPONENT/$tree"
  if [[ ! -f "$snapshot/.snapshot-complete" ]]; then
    mkdir -p "$STATE_ROOT/sources/$COMPONENT"
    [[ ! -e "$snapshot" ]] || die "本地源码快照目录不完整，请人工检查：$snapshot"
    temp=$(mktemp -d "$STATE_ROOT/sources/$COMPONENT/.snapshot.XXXXXX")
    GIT_INDEX_FILE="$index" git -C "$repo" checkout-index --all --prefix="$temp/"
    finalize_source_snapshot "$temp"
    mv "$temp" "$snapshot"
  fi
  COMPONENT_SOURCE_DIR=$snapshot
  rm -f "$index"
  trap - RETURN
}

ensure_state() {
  mkdir -p "$STATE_ROOT/shared" "$STATE_ROOT/components" "$STATE_ROOT/backups/zenvis" \
    "$STATE_ROOT/backups/agent" "$STATE_ROOT/backups/analyzer" "$STATE_ROOT/sources"
  chmod 700 "$STATE_ROOT" "$STATE_ROOT/shared" "$STATE_ROOT/components" "$STATE_ROOT/backups" \
    "$STATE_ROOT/backups/zenvis" "$STATE_ROOT/backups/agent" "$STATE_ROOT/backups/analyzer" \
    "$STATE_ROOT/sources"
}

ensure_analyzer_runtime() {
  local image temp
  if [[ ! -f "$ANALYZER_IMAGE_ENV" ]]; then
    image=$(docker inspect --format '{{.Config.Image}}' zenvis-service-analyzer 2>/dev/null || true)
    [[ -n "$image" ]] || die "无法从现有 Analyzer 容器初始化镜像状态"
    printf 'ANALYZER_IMAGE=%s\n' "$image" >"$ANALYZER_IMAGE_ENV"
    chmod 600 "$ANALYZER_IMAGE_ENV"
  fi
  if [[ ! -f "$ANALYZER_ZONE_FILE" ]]; then
    [[ -f "$ANALYZER_REPO/configs/zones.json" ]] || die "Analyzer 区域配置不存在"
    install -m 0644 "$ANALYZER_REPO/configs/zones.json" "$ANALYZER_ZONE_FILE"
  fi
  temp=$(mktemp "${ANALYZER_COMPOSE_OVERRIDE}.XXXXXX")
  cat >"$temp" <<YAML
services:
  zenvis-service-analyzer:
    image: \${ANALYZER_IMAGE:?ANALYZER_IMAGE is required}
    env_file: !override
      - $ANALYZER_ENV
    ports: !override
      - "127.0.0.1:\${ANALYZER_HTTP_PORT:-18080}:18080"
    volumes: !override
      - $ANALYZER_ZONE_FILE:/app/configs/zones.json:ro
YAML
  chmod 600 "$temp"
  if [[ -f "$ANALYZER_COMPOSE_OVERRIDE" ]] && cmp -s "$temp" "$ANALYZER_COMPOSE_OVERRIDE"; then
    rm -f "$temp"
  else
    mv "$temp" "$ANALYZER_COMPOSE_OVERRIDE"
  fi
}

ensure_agent_runtime() {
  local backend_image frontend_image backend_endpoint frontend_endpoint bind_host frontend_bind_host
  local backend_port frontend_port
  if [[ ! -f "$AGENT_IMAGE_ENV" ]]; then
    backend_image=$(docker inspect --format '{{.Config.Image}}' lubinsun-test-backend-1 2>/dev/null || true)
    frontend_image=$(docker inspect --format '{{.Config.Image}}' lubinsun-test-frontend-1 2>/dev/null || true)
    [[ -n "$backend_image" && -n "$frontend_image" ]] || die "无法从现有 Agent 容器初始化镜像状态"
    {
      printf 'BACKEND_IMAGE=%s\n' "$backend_image"
      printf 'FRONTEND_IMAGE=%s\n' "$frontend_image"
    } >"$AGENT_IMAGE_ENV"
    chmod 600 "$AGENT_IMAGE_ENV"
  fi
  if [[ ! -f "$AGENT_RUNTIME_ENV" ]]; then
    backend_endpoint=$(docker port lubinsun-test-backend-1 8080/tcp | head -n 1)
    frontend_endpoint=$(docker port lubinsun-test-frontend-1 80/tcp | head -n 1)
    [[ -n "$backend_endpoint" && -n "$frontend_endpoint" ]] \
      || die "无法从现有 Agent 容器初始化发布端口"
    bind_host=${backend_endpoint%:*}
    frontend_bind_host=${frontend_endpoint%:*}
    backend_port=${backend_endpoint##*:}
    frontend_port=${frontend_endpoint##*:}
    [[ "$bind_host" == "$frontend_bind_host" ]] || die "Agent 前后端绑定地址不一致"
    [[ "$bind_host" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "Agent 绑定地址格式异常"
    [[ "$backend_port" =~ ^[0-9]+$ && "$frontend_port" =~ ^[0-9]+$ ]] \
      || die "Agent 发布端口格式异常"
    {
      printf 'LOCAL_BIND_HOST=%s\n' "$bind_host"
      printf 'BACKEND_PORT=%s\n' "$backend_port"
      printf 'FRONTEND_PORT=%s\n' "$frontend_port"
    } >"$AGENT_RUNTIME_ENV"
    chmod 600 "$AGENT_RUNTIME_ENV"
  fi
  local mysql_data
  mysql_data=$(env_value "$AGENT_RUNTIME_ENV" AGENT_MYSQL_DATA_DIR)
  if [[ -z "$mysql_data" ]]; then
    mysql_data=$(docker inspect --format '{{range .Mounts}}{{if eq .Destination "/var/lib/mysql"}}{{.Source}}{{end}}{{end}}' \
      lubinsun-test-mysql-1 2>/dev/null || true)
    [[ -n "$mysql_data" && "$mysql_data" == "$WORKSPACE_ROOT"/* ]] \
      || die "无法从现有 Agent MySQL 容器发现安全的数据目录"
    set_env_key "$AGENT_RUNTIME_ENV" AGENT_MYSQL_DATA_DIR "$mysql_data"
  fi
  mkdir -p "$mysql_data" "$AGENT_REPO/mysql/backups"
  set_env_key "$AGENT_RUNTIME_ENV" AGENT_MYSQL_BACKUP_DIR "$AGENT_REPO/mysql/backups"
  if [[ ! -f "$AGENT_SOURCE_ENV" ]]; then
    printf 'AGENT_SOURCE_DIR=%s\n' "$AGENT_REPO" >"$AGENT_SOURCE_ENV"
    chmod 600 "$AGENT_SOURCE_ENV"
  fi
}

ensure_zenvis_runtime() {
  if [[ ! -f "$ZENVIS_SOURCE_ENV" ]]; then
    printf 'ZENVIS_SOURCE_DIR=%s\n' "$ZENVIS_REPO" >"$ZENVIS_SOURCE_ENV"
    chmod 600 "$ZENVIS_SOURCE_ENV"
  fi
}

ensure_zenvis_images() {
  local backend_image frontend_image
  [[ -f "$ZENVIS_IMAGE_ENV" ]] && return
  backend_image=$(docker inspect --format '{{.Config.Image}}' zenvis-backend 2>/dev/null || true)
  frontend_image=$(docker inspect --format '{{.Config.Image}}' zenvis-frontend 2>/dev/null || true)
  [[ -n "$backend_image" && -n "$frontend_image" ]] || die "无法从现有 ZenVis 容器初始化镜像状态"
  {
    printf 'ZENVIS_BACKEND_IMAGE=%s\n' "$backend_image"
    printf 'ZENVIS_FRONTEND_IMAGE=%s\n' "$frontend_image"
  } >"$ZENVIS_IMAGE_ENV"
  chmod 600 "$ZENVIS_IMAGE_ENV"
}

zenvis_source_dir() {
  local source
  ensure_zenvis_runtime
  source=$(env_value "$ZENVIS_SOURCE_ENV" ZENVIS_SOURCE_DIR)
  [[ -n "$source" && -f "$source/deploy/docker-compose.yml" \
    && -f "$source/deploy/docker-compose.automation.yml" ]] || die "ZenVis 活动源码快照无效"
  [[ "$source" == "$ZENVIS_REPO" || "$source" =~ ^$STATE_ROOT/sources/zenvis/[0-9a-f]{40}$ ]] \
    || die "ZenVis 活动源码快照路径越界或格式异常"
  printf '%s' "$source"
}

zenvis_compose() {
  local source
  ensure_zenvis_images
  source=$(zenvis_source_dir)
  docker compose -p zenvis --env-file "$ZENVIS_ENV" --env-file "$ZENVIS_IMAGE_ENV" \
    --project-directory "$source/deploy" \
    -f "$source/deploy/docker-compose.yml" \
    -f "$source/deploy/docker-compose.automation.yml" "$@"
}

assert_zenvis_compose_invariants() {
  local config
  config=$(zenvis_compose config --format json)
  if ! jq -e '
      (.name == "zenvis") and
      (.services["zenvis-backend"].environment.LUBINSUN_BASE_URL | type == "string" and length > 0) and
      (.services["zenvis-backend"].environment.LUBINSUN_INTEGRATION_TOKEN | type == "string" and length > 0) and
      any(.services["zenvis-backend"].ports[]?; .target == 11001 and .published == "11001") and
      any(.services["zenvis-frontend"].ports[]?; .target == 11000 and .published == "11000")
    ' <<<"$config" >/dev/null; then
    die "ZenVis Compose 违反端口或 Lubinsun 集成配置不变量，拒绝部署"
  fi
}

agent_source_dir() {
  local source
  source=$(env_value "$AGENT_SOURCE_ENV" AGENT_SOURCE_DIR)
  [[ -n "$source" && -f "$source/docker-compose.yml" ]] || die "Agent 活动源码快照无效"
  [[ "$source" == "$AGENT_REPO" || "$source" =~ ^$STATE_ROOT/sources/lubinsun-agent/[0-9a-f]{40}$ ]] \
    || die "Agent 活动源码快照路径越界或格式异常"
  printf '%s' "$source"
}

agent_compose_for() {
  local source=$1 image_env=$2 profile override args
  shift 2
  override="$source/deploy/docker-compose.production.yml"
  [[ -f "$override" ]] || die "Agent 活动源码快照缺少 production Compose 覆盖"
  args=(-p lubinsun-test --env-file "$AGENT_ENV" --env-file "$image_env"
    --env-file "$AGENT_RUNTIME_ENV" --project-directory "$source"
    -f "$source/docker-compose.yml" -f "$override")
  profile=$(env_value "$AGENT_ENV" TOOL_RUNTIME_PROFILE)
  case "${profile:-standard}" in
    standard) ;;
    root) args+=(-f "$source/docker-compose.tools-root.yml") ;;
    diagnostic) args+=(-f "$source/docker-compose.tools-diagnostic.yml") ;;
    *) die "不支持的 Agent TOOL_RUNTIME_PROFILE：$profile" ;;
  esac
  docker compose "${args[@]}" "$@"
}

agent_compose() {
  local source
  ensure_agent_runtime
  source=$(agent_source_dir)
  agent_compose_for "$source" "$AGENT_IMAGE_ENV" "$@"
}

assert_agent_compose_invariants() {
  local config bind_host api_port web_port
  config=$(agent_compose config --format json)
  bind_host=$(env_value "$AGENT_RUNTIME_ENV" LOCAL_BIND_HOST)
  api_port=$(env_value "$AGENT_RUNTIME_ENV" BACKEND_PORT)
  web_port=$(env_value "$AGENT_RUNTIME_ENV" FRONTEND_PORT)
  if ! jq -e \
      --arg host "$bind_host" \
      --arg api_port "$api_port" \
      --arg web_port "$web_port" \
      --arg mysql_data "$(env_value "$AGENT_RUNTIME_ENV" AGENT_MYSQL_DATA_DIR)" \
      '
        (.name == "lubinsun-test") and
        ((["mysql","tool-executor-local","tool-executor-standard","tool-executor-privileged","backend","frontend"] - (.services | keys)) | length == 0) and
        (. as $root | [$root.services.mysql,$root.services["tool-executor-local"],$root.services["tool-executor-standard"],$root.services["tool-executor-privileged"],$root.services.backend,$root.services.frontend] | all(.[]; .container_name == null and .network_mode != "host")) and
        (.services.backend.ports | length == 1) and
        (.services.frontend.ports | length == 1) and
        any(.services.backend.ports[]?; .target == 8080 and .published == $api_port and .host_ip == $host) and
        any(.services.frontend.ports[]?; .target == 80 and .published == $web_port and .host_ip == $host) and
        any(.services.mysql.volumes[]?; .type == "bind" and .source == $mysql_data and .target == "/var/lib/mysql") and
        any(.services.backend.volumes[]?; .type == "volume" and .source == "agent-data" and .target == "/var/lib/lubinsun-agent") and
        ([.services.backend.volumes[]? | select(.target == "/app/skills")] | length == 0) and
        (.volumes["agent-data"].name == "lubinsun-test_agent-data") and
        (.volumes["agent-data"].external == true)
      ' <<<"$config" >/dev/null; then
    die "Agent Compose 违反单实例不变量，拒绝部署"
  fi
}

analyzer_source_dir() {
