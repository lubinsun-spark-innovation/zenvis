set_env_key() {
  local file=$1 key=$2 value=$3 temp
  [[ "$value" =~ ^[A-Za-z0-9_./:@+-]+$ ]] || die "环境状态值含非法字符：$key"
  temp=$(mktemp "${file}.XXXXXX")
  if [[ -f "$file" ]]; then
    awk -v key="$key" -v value="$value" '
      BEGIN { found=0 }
      $0 ~ "^" key "=" { print key "=" value; found=1; next }
      { print }
      END { if (!found) print key "=" value }
    ' "$file" >"$temp"
  else
    printf '%s=%s\n' "$key" "$value" >"$temp"
  fi
  chmod 600 "$temp"
  mv "$temp" "$file"
}
verify_image_metadata() {
  local image=$1 expected_revision=$2 expected_digest=$3 actual_revision actual_digest
  actual_revision=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$image")
  actual_digest=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.source-digest"}}' "$image")
  [[ "$actual_revision" == "$expected_revision" ]] \
    || die "镜像 revision 不一致：image=$image expected=$expected_revision actual=$actual_revision"
  [[ "$actual_digest" == "$expected_digest" ]] \
    || die "镜像部署输入摘要不一致：image=$image expected=$expected_digest actual=$actual_digest"
}

reuse_image_if_present() {
  local image=$1 expected_digest=$2 actual_digest
  docker image inspect "$image" >/dev/null 2>&1 || return 1
  actual_digest=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.source-digest"}}' "$image")
  [[ "$actual_digest" == "$expected_digest" ]] \
    || die "不可变镜像标签发生冲突：image=$image expected_digest=$expected_digest actual_digest=${actual_digest:-missing}"
  log "复用已校验的不可变镜像：$image"
}

preserve_container_image() {
  local container=$1 component=$2 image_id short tag
  image_id=$(docker inspect --format '{{.Image}}' "$container" 2>/dev/null || true)
  [[ "$image_id" =~ ^sha256:[0-9a-f]{64}$ ]] || die "无法保存 $component 当前运行镜像"
  short=${image_id#sha256:}
  short=${short:0:12}
  tag="lubinsun/rollback-${component}:$(date -u '+%Y%m%d%H%M%S')-$short"
  docker image tag "$image_id" "$tag"
  [[ "$(docker image inspect --format '{{.Id}}' "$tag")" == "$image_id" ]] \
    || die "保存 $component 回滚镜像失败"
  printf '%s' "$tag"
}

container_source_digest() {
  docker inspect --format '{{index .Config.Labels "org.opencontainers.image.source-digest"}}' "$1" 2>/dev/null || true
}

verify_running_image() {
  local container=$1 expected_image=$2 expected_digest=$3 expected_id actual_id actual_digest
  expected_id=$(docker image inspect --format '{{.Id}}' "$expected_image" 2>/dev/null) \
    || { log "目标镜像不存在：$expected_image" >&2; return 1; }
  actual_id=$(docker inspect --format '{{.Image}}' "$container" 2>/dev/null || true)
  actual_digest=$(container_source_digest "$container")
  [[ "$actual_id" == "$expected_id" && "$actual_digest" == "$expected_digest" ]] || {
    log "运行镜像漂移：container=$container expected_id=$expected_id actual_id=${actual_id:-missing} expected_digest=$expected_digest actual_digest=${actual_digest:-missing}" >&2
    return 1
  }
}

verify_running_ref() {
  local container=$1 image=$2 digest=${3:-} expected_id actual_id
  if [[ -n "$digest" ]]; then
    verify_running_image "$container" "$image" "$digest"
    return
  fi
  expected_id=$(docker image inspect --format '{{.Id}}' "$image" 2>/dev/null) || return 1
  actual_id=$(docker inspect --format '{{.Image}}' "$container" 2>/dev/null || true)
  [[ "$actual_id" == "$expected_id" ]]
}

compose_hashes() {
  case "$1" in
    zenvis) zenvis_compose config --hash '*' ;;
    agent) agent_compose config --hash '*' ;;
    analyzer) analyzer_compose config --hash '*' ;;
    *) die "未知 Compose 栈：$1" ;;
  esac
}

compose_container() {
  case "$1" in
    zenvis) zenvis_compose ps -q "$2" ;;
    agent) agent_compose ps -q "$2" ;;
    analyzer) analyzer_compose ps -q "$2" ;;
    *) die "未知 Compose 栈：$1" ;;
  esac
}

expected_service_hash() {
  local stack=$1 service=$2
  compose_hashes "$stack" | awk -v service="$service" '$1 == service {print $2}'
}

service_config_matches() {
  local stack=$1 service=$2 expected container actual actual_project actual_service
  expected=$(expected_service_hash "$stack" "$service")
  [[ -n "$expected" ]] || return 1
  container=$(compose_container "$stack" "$service" | sed -n '1p')
  [[ -n "$container" ]] || return 1
  actual=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.config-hash"}}' "$container" 2>/dev/null || true)
  actual_project=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$container" 2>/dev/null || true)
  actual_service=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.service"}}' "$container" 2>/dev/null || true)
  case "$stack" in
    zenvis) [[ "$actual_project" == zenvis ]] || return 1 ;;
    agent) [[ "$actual_project" == lubinsun-test ]] || return 1 ;;
    analyzer) [[ "$actual_project" == deploy ]] || return 1 ;;
  esac
  [[ "$actual_service" == "$service" && "$actual" == "$expected" ]]
}

service_runtime_config_digest() {
  local stack=$1 service=$2 container
  container=$(compose_container "$stack" "$service" | sed -n '1p')
  [[ -n "$container" ]] || return 1
  docker inspect --format '{{index .Config.Labels "com.docker.compose.config-hash"}}' "$container" 2>/dev/null
}

service_runtime_identity_matches() {
  local stack=$1 service=$2 container actual_project actual_service
  container=$(compose_container "$stack" "$service" | sed -n '1p')
  [[ -n "$container" ]] || return 1
  actual_project=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.project"}}' "$container" 2>/dev/null || true)
  actual_service=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.service"}}' "$container" 2>/dev/null || true)
  case "$stack" in
    zenvis) [[ "$actual_project" == zenvis ]] || return 1 ;;
    agent) [[ "$actual_project" == lubinsun-test ]] || return 1 ;;
    analyzer) [[ "$actual_project" == deploy ]] || return 1 ;;
  esac
  [[ "$actual_service" == "$service" ]]
}

all_service_configs_match() {
  local stack=$1 service
  shift
  for service in "$@"; do
    service_config_matches "$stack" "$service" || return 1
  done
}

agent_target_changed_services() {
  local source=$1 image_env=$2 service expected container actual
  while read -r service expected; do
    [[ -n "$service" && -n "$expected" ]] || continue
    container=$(docker ps -aq \
      --filter label=com.docker.compose.project=lubinsun-test \
      --filter "label=com.docker.compose.service=$service" | sed -n '1p')
    actual=''
    [[ -z "$container" ]] \
      || actual=$(docker inspect --format '{{index .Config.Labels "com.docker.compose.config-hash"}}' "$container" 2>/dev/null || true)
    [[ "$actual" == "$expected" ]] || printf '%s\n' "$service"
  done < <(agent_compose_for "$source" "$image_env" config --hash '*')
}

component_config_digest() {
  local component=$1
  case "$component" in
    zenvis) compose_hashes zenvis | LC_ALL=C sort | sha256sum | awk '{print $1}' ;;
    zenvis-backend) expected_service_hash zenvis zenvis-backend ;;
    zenvis-frontend) expected_service_hash zenvis zenvis-frontend ;;
    zenvis-analyzer) expected_service_hash analyzer zenvis-service-analyzer ;;
    lubinsun-agent) compose_hashes agent | LC_ALL=C sort | sha256sum | awk '{print $1}' ;;
    *) printf '%s' '' ;;
  esac
}

component_runtime_config_digest() {
  local component=$1
  case "$component" in
    zenvis-backend) service_runtime_config_digest zenvis zenvis-backend ;;
    zenvis-frontend) service_runtime_config_digest zenvis zenvis-frontend ;;
    zenvis-analyzer) service_runtime_config_digest analyzer zenvis-service-analyzer ;;
    *) printf '%s' '' ;;
  esac
}

refresh_component_config_manifest() {
  local component=$1 current config_digest runtime_config_digest
  current="$STATE_ROOT/components/$component/current.env"
  [[ -f "$current" ]] || return 0
  config_digest=$(component_config_digest "$component")
  if [[ -n "$config_digest" ]]; then
    set_env_key "$current" config_digest "$config_digest"
  fi
  runtime_config_digest=$(component_runtime_config_digest "$component" || true)
  if [[ -n "$runtime_config_digest" ]]; then
    set_env_key "$current" runtime_config_digest "$runtime_config_digest"
  fi
  return 0
}

reconcile_related_zenvis_manifests() {
  case "$1" in
    zenvis)
      refresh_component_config_manifest zenvis-backend
      refresh_component_config_manifest zenvis-frontend
      ;;
    zenvis-backend|zenvis-frontend)
      refresh_component_config_manifest zenvis
      ;;
  esac
}

component_runtime_matches() {
  local component=$1 current config_digest runtime_config_digest
  current="$STATE_ROOT/components/$component/current.env"
  [[ -f "$current" ]] || return 1
  [[ "$(manifest_value "$current" source_digest)" == "$SOURCE_DIGEST" ]] || return 1
  config_digest=$(component_config_digest "$component")
  [[ -n "$config_digest" && "$(manifest_value "$current" config_digest)" == "$config_digest" ]] || return 1
  case "$component" in
    zenvis-backend)
      [[ "$(container_source_digest zenvis-backend)" == "$SOURCE_DIGEST" ]] \
        && service_config_matches zenvis zenvis-backend
      ;;
    zenvis-frontend)
      [[ "$(container_source_digest zenvis-frontend)" == "$SOURCE_DIGEST" ]] \
        && service_config_matches zenvis zenvis-frontend
      ;;
    zenvis-analyzer)
      [[ "$(container_source_digest zenvis-service-analyzer)" == "$SOURCE_DIGEST" ]] \
        && service_runtime_identity_matches analyzer zenvis-service-analyzer \
        && runtime_config_digest=$(component_runtime_config_digest zenvis-analyzer) \
        && [[ -n "$runtime_config_digest" \
          && "$(manifest_value "$current" runtime_config_digest)" == "$runtime_config_digest" ]] \
        && [[ "$(manifest_value "$current" zones_digest)" == "$(sha256sum "$ANALYZER_ZONE_FILE" | awk '{print $1}')" ]] \
        && [[ "$(sha256sum "$ANALYZER_ZONE_FILE" | awk '{print $1}')" == \
          "$(sha256sum "$COMPONENT_SOURCE_DIR/configs/zones.json" | awk '{print $1}')" ]]
      ;;
    lubinsun-agent)
      [[ "$(manifest_value "$current" agent_stack_digest)" == "$AGENT_STACK_DIGEST" \
        && "$(container_source_digest lubinsun-test-backend-1)" == "$AGENT_BACKEND_DIGEST" \
        && "$(container_source_digest lubinsun-test-tool-executor-local-1)" == "$AGENT_BACKEND_DIGEST" \
        && "$(container_source_digest lubinsun-test-tool-executor-standard-1)" == "$AGENT_BACKEND_DIGEST" \
        && "$(container_source_digest lubinsun-test-tool-executor-privileged-1)" == "$AGENT_BACKEND_DIGEST" \
        && "$(container_source_digest lubinsun-test-frontend-1)" == "$AGENT_FRONTEND_DIGEST" ]] \
        && all_service_configs_match agent mysql tool-executor-local tool-executor-standard \
          tool-executor-privileged backend frontend
      ;;
    zenvis)
      all_service_configs_match zenvis kafka-service clickhouse-service vectum-service redis-service \
        redis-stack-service mysql-service zenvis-backend zenvis-frontend
      ;;
    plugin-lubinsun|plugin-onesoc) return 1 ;;
    *) return 1 ;;
  esac
}

runtime_component_digest() {
  local component=$1 backend frontend
  case "$component" in
    zenvis-backend) container_source_digest zenvis-backend ;;
    zenvis-frontend) container_source_digest zenvis-frontend ;;
    zenvis-analyzer) container_source_digest zenvis-service-analyzer ;;
    lubinsun-agent)
      backend=$(container_source_digest lubinsun-test-backend-1)
      frontend=$(container_source_digest lubinsun-test-frontend-1)
      printf 'backend:%s,frontend:%s' "${backend:-unknown}" "${frontend:-unknown}"
      ;;
    zenvis)
      zenvis_compose config --format json 2>/dev/null | jq -S . | sha256sum | awk '{print $1}'
      ;;
    *) printf '%s' unknown ;;
  esac
}

write_verification() {
  local component=$1 result=$2 dir temp
  dir="$STATE_ROOT/components/$component"
  mkdir -p "$dir"
  temp=$(mktemp "$dir/last-verification.XXXXXX")
  {
    printf 'component=%s\n' "$component"
    printf 'repository=%s\n' "$COMPONENT_GITHUB"
    printf 'revision=%s\n' "$SOURCE_REVISION"
    printf 'source_tree=%s\n' "$SOURCE_TREE"
    printf 'source_digest=%s\n' "$SOURCE_DIGEST"
    printf 'agent_backend_digest=%s\n' "${AGENT_BACKEND_DIGEST:-}"
    printf 'agent_frontend_digest=%s\n' "${AGENT_FRONTEND_DIGEST:-}"
    printf 'agent_stack_digest=%s\n' "${AGENT_STACK_DIGEST:-}"
    printf 'source_kind=%s\n' "$SOURCE_KIND"
    printf 'result=%s\n' "$result"
    printf 'verified_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$dir/last-verification.env"
}

wait_http() {
  local url=$1 label=$2
  for ((attempt=1; attempt<=HEALTH_ATTEMPTS; attempt++)); do
    if curl -fsS --connect-timeout 3 --max-time 10 "$url" >/dev/null; then
      log "$label 健康检查通过：$url"
      return 0
    fi
    sleep 2
  done
  log "$label 健康检查失败：$url" >&2
  return 1
}

wait_service() {
  local stack=$1 service=$2 container state health
  for ((attempt=1; attempt<=HEALTH_ATTEMPTS; attempt++)); do
    case "$stack" in
      zenvis) container=$(zenvis_compose ps -q "$service" 2>/dev/null | sed -n '1p') ;;
      agent) container=$(agent_compose ps -q "$service" 2>/dev/null | sed -n '1p') ;;
      analyzer) container=$(analyzer_compose ps -q "$service" 2>/dev/null | sed -n '1p') ;;
      *) die "未知服务栈：$stack" ;;
    esac
    if [[ -n "$container" ]]; then
      state=$(docker inspect --format '{{.State.Status}}' "$container" 2>/dev/null || true)
      health=$(docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$container" 2>/dev/null || true)
      [[ "$state" == running && ( "$health" == healthy || "$health" == none ) ]] && return 0
      [[ "$state" == exited || "$state" == dead ]] && return 1
    fi
    sleep 2
  done
  return 1
}

verify_zenvis_stack() {
  local service
  for service in kafka-service clickhouse-service vectum-service redis-service redis-stack-service mysql-service zenvis-backend zenvis-frontend; do
    wait_service zenvis "$service" || { zenvis_compose ps -a; return 1; }
  done
  wait_http http://127.0.0.1:11000/ 'ZenVis Web' \
    && wait_http http://127.0.0.1:11001/ 'ZenVis API' \
    && wait_http http://127.0.0.1:11002/ 'Vectum'
}

verify_zenvis_backend() {
  local base_url_present token_present token response
  wait_service zenvis zenvis-backend || return 1
  wait_http http://127.0.0.1:11001/actuator/health/readiness 'ZenVis API readiness' || return 1
  base_url_present=$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' zenvis-backend \
    | awk -F= '$1 == "LUBINSUN_BASE_URL" && length($2) > 0 {print "yes"}')
  token_present=$(docker inspect --format '{{range .Config.Env}}{{println .}}{{end}}' zenvis-backend \
    | awk -F= '$1 == "LUBINSUN_INTEGRATION_TOKEN" && length($2) > 0 {print "yes"}')
  [[ "$base_url_present" == yes && "$token_present" == yes ]] || {
    log "ZenVis Backend 缺少 Lubinsun 运行时配置" >&2
    return 1
  }
  token=$(api_token)
  response=$(curl -fsS --connect-timeout 3 --max-time 15 \
    -H "Authorization: Bearer $token" \
    http://127.0.0.1:11001/api/v1/plugin/com.coolxer.plugin.lubinsun/connection) || return 1
  jq -e '.connected == true and .disabled == false' <<<"$response" >/dev/null || {
    log "ZenVis Lubinsun 插件连接 smoke 失败" >&2
    return 1
  }
}

verify_component_runtime() {
  local component=$1 backend_image frontend_image analyzer_image
  case "$component" in
    zenvis) assert_zenvis_compose_invariants; verify_zenvis_stack ;;
    zenvis-backend)
      backend_image=$(env_value "$ZENVIS_IMAGE_ENV" ZENVIS_BACKEND_IMAGE)
      assert_zenvis_compose_invariants \
        && verify_zenvis_backend \
        && verify_running_image zenvis-backend "$backend_image" "$SOURCE_DIGEST"
      ;;
    zenvis-frontend)
      frontend_image=$(env_value "$ZENVIS_IMAGE_ENV" ZENVIS_FRONTEND_IMAGE)
      wait_service zenvis zenvis-frontend \
        && wait_http http://127.0.0.1:11000/ 'ZenVis Web' \
        && verify_running_image zenvis-frontend "$frontend_image" "$SOURCE_DIGEST"
      ;;
    zenvis-analyzer)
      analyzer_image=$(env_value "$ANALYZER_IMAGE_ENV" ANALYZER_IMAGE)
      assert_analyzer_compose_invariants \
        && verify_analyzer_stack \
        && cmp -s "$ANALYZER_ZONE_FILE" "$COMPONENT_SOURCE_DIR/configs/zones.json" \
        && verify_running_image zenvis-service-analyzer "$analyzer_image" "$SOURCE_DIGEST"
      ;;
    lubinsun-agent)
      backend_image=$(env_value "$AGENT_IMAGE_ENV" BACKEND_IMAGE)
      frontend_image=$(env_value "$AGENT_IMAGE_ENV" FRONTEND_IMAGE)
      assert_agent_compose_invariants \
        && verify_agent_stack \
        && verify_running_image lubinsun-test-backend-1 "$backend_image" "$AGENT_BACKEND_DIGEST" \
        && verify_running_image lubinsun-test-tool-executor-local-1 "$backend_image" "$AGENT_BACKEND_DIGEST" \
        && verify_running_image lubinsun-test-tool-executor-standard-1 "$backend_image" "$AGENT_BACKEND_DIGEST" \
        && verify_running_image lubinsun-test-tool-executor-privileged-1 "$backend_image" "$AGENT_BACKEND_DIGEST" \
        && verify_running_image lubinsun-test-frontend-1 "$frontend_image" "$AGENT_FRONTEND_DIGEST"
