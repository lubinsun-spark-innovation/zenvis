agent_health_host() {
  local host
  host=$(env_value "$AGENT_RUNTIME_ENV" LOCAL_BIND_HOST)
  case "${host:-127.0.0.1}" in
    0.0.0.0) printf '127.0.0.1' ;;
    *) printf '%s' "$host" ;;
  esac
}

migration_manifest_from_source() {
  local source=$1 output=$2 file
  : >"$output"
  while IFS= read -r -d '' file; do
    printf '%s  %s\n' "$(sha256sum "$source/backend/migrations/$file" | awk '{print $1}')" "$file" >>"$output"
  done < <(find "$source/backend/migrations" -maxdepth 1 -type f -name '*.sql' \
    -printf '%f\0' | LC_ALL=C sort -z)
  [[ -s "$output" ]] || die "Agent migration 清单为空"
}

migration_manifest_from_container() {
  local container=$1 output=$2
  docker exec "$container" sh -euc \
    'cd /app/migrations; for file in $(find . -maxdepth 1 -type f -name "*.sql" -printf "%f\n" | sort); do sha256sum "$file"; done' \
    >"$output"
  [[ -s "$output" ]] || die "无法从当前 Agent 镜像建立 migration 基线"
}

agent_db_migrations() {
  local mysql_id
  mysql_id=$(agent_compose ps -q mysql)
  [[ -n "$mysql_id" ]] || return 1
  docker exec "$mysql_id" sh -c \
    'exec mysql -N -B -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" "$MYSQL_DATABASE" -e "SELECT version FROM schema_migrations ORDER BY version"' \
    2>/dev/null | LC_ALL=C sort
}

assert_db_migrations_match_manifest() {
  local manifest=$1 files versions
  files=$(mktemp "$STATE_ROOT/migration-files.XXXXXX")
  versions=$(mktemp "$STATE_ROOT/migration-db.XXXXXX")
  trap 'rm -f "${files:-}" "${versions:-}"' RETURN
  awk '{print $2}' "$manifest" | LC_ALL=C sort >"$files"
  agent_db_migrations >"$versions"
  if ! cmp -s "$files" "$versions"; then
    log "Agent 数据库 migration 集合与发布清单不一致" >&2
    diff -u "$versions" "$files" >&2 || true
    return 1
  fi
  rm -f "$files" "$versions"
  trap - RETURN
}

prepare_agent_migrations() {
  local dir current baseline hash file candidate_hash db_file image_files
  dir="$STATE_ROOT/components/lubinsun-agent"
  mkdir -p "$dir"
  PENDING_MIGRATION_MANIFEST=$(mktemp "$dir/pending-migrations.XXXXXX")
  migration_manifest_from_source "$COMPONENT_SOURCE_DIR" "$PENDING_MIGRATION_MANIFEST"
  current="$dir/current.env"
  baseline=$(manifest_value "$current" migration_manifest)
  if [[ -z "$baseline" || ! -f "$baseline" ]]; then
    baseline="$dir/bootstrap-migrations.sha256"
    if [[ ! -f "$baseline" ]]; then
      migration_manifest_from_container lubinsun-test-backend-1 "$baseline.tmp"
      db_file=$(mktemp "$dir/bootstrap-db.XXXXXX")
      image_files=$(mktemp "$dir/bootstrap-image.XXXXXX")
      agent_db_migrations >"$db_file"
      awk '{print $2}' "$baseline.tmp" | LC_ALL=C sort >"$image_files"
      while IFS= read -r file; do
        printf 'LEGACY_DB_ONLY  %s\n' "$file" >>"$baseline.tmp"
      done < <(comm -23 "$db_file" "$image_files")
      LC_ALL=C sort -k2,2 "$baseline.tmp" -o "$baseline.tmp"
      rm -f "$db_file" "$image_files"
      chmod 600 "$baseline.tmp"
      mv "$baseline.tmp" "$baseline"
    fi
  fi
  BASELINE_MIGRATION_MANIFEST=$baseline
  assert_db_migrations_match_manifest "$baseline" \
    || die "当前 Agent 镜像、数据库与 migration 基线不一致，拒绝自动升级"
  while read -r hash file; do
    candidate_hash=$(awk -v file="$file" '$2 == file {print $1}' "$PENDING_MIGRATION_MANIFEST")
    if [[ "$hash" == LEGACY_DB_ONLY ]]; then
      [[ -z "$candidate_hash" ]] || die "历史 DB-only migration 不得以未知内容重新引入：$file"
      printf 'LEGACY_DB_ONLY  %s\n' "$file" >>"$PENDING_MIGRATION_MANIFEST"
      continue
    fi
    [[ "$candidate_hash" == "$hash" ]] \
      || die "已发布 migration 被删除或改写：$file"
  done <"$baseline"
  LC_ALL=C sort -k2,2 "$PENDING_MIGRATION_MANIFEST" -o "$PENDING_MIGRATION_MANIFEST"
  chmod 600 "$PENDING_MIGRATION_MANIFEST"
}

verify_agent_image_migrations() {
  local image=$1 actual expected
  actual=$(mktemp "$STATE_ROOT/image-migrations.XXXXXX")
  expected=$(mktemp "$STATE_ROOT/source-migrations.XXXXXX")
  trap 'rm -f "${actual:-}" "${expected:-}"' RETURN
  if ! docker run --rm --entrypoint sh "$image" -euc \
    'cd /app/migrations; for file in $(find . -maxdepth 1 -type f -name "*.sql" -printf "%f\n" | sort); do sha256sum "$file"; done' \
    >"$actual"; then
    rm -f "$actual" "$expected"
    trap - RETURN
    die "无法读取 Agent 新镜像内的 migration"
  fi
  awk 'length($1) == 64 && $1 ~ /^[0-9a-f]+$/ {print}' "$PENDING_MIGRATION_MANIFEST" >"$expected"
  if ! cmp -s "$expected" "$actual"; then
    rm -f "$actual" "$expected"
    trap - RETURN
    die "Agent 新镜像内 migration 与目标源码不一致"
  fi
  rm -f "$actual" "$expected"
  trap - RETURN
}

commit_agent_migrations() {
  local revision=$1 dir release_key target
  dir="$STATE_ROOT/components/lubinsun-agent/releases"
  mkdir -p "$dir"
  release_key=${revision//[^A-Za-z0-9_.-]/_}
  target="$dir/${release_key}.migrations.sha256"
  cp "$PENDING_MIGRATION_MANIFEST" "$target.tmp"
  chmod 600 "$target.tmp"
  mv "$target.tmp" "$target"
  MIGRATION_MANIFEST=$target
  MIGRATION_SET_DIGEST=$(sha256sum "$target" | awk '{print $1}')
}

verify_agent_stack() {
  local service host api_port web_port manifest
  for service in mysql tool-executor-local tool-executor-standard tool-executor-privileged backend frontend; do
    wait_service agent "$service" || { agent_compose ps -a; return 1; }
  done
  host=$(agent_health_host)
  api_port=$(env_value "$AGENT_RUNTIME_ENV" BACKEND_PORT)
  web_port=$(env_value "$AGENT_RUNTIME_ENV" FRONTEND_PORT)
  wait_http "http://${host}:${api_port}/api/healthz" 'Lubinsun Agent API' \
    && wait_http "http://${host}:${web_port}/" 'Lubinsun Agent Web' || return 1
  manifest=${VERIFY_MIGRATION_MANIFEST_OVERRIDE:-${PENDING_MIGRATION_MANIFEST:-}}
  [[ -n "$manifest" && -f "$manifest" ]] \
    || manifest=$(manifest_value "$STATE_ROOT/components/lubinsun-agent/current.env" migration_manifest)
  [[ -n "$manifest" && -f "$manifest" ]] \
    || { log "Agent migration 发布清单不存在" >&2; return 1; }
  assert_db_migrations_match_manifest "$manifest"
}

verify_analyzer_stack() {
  local container expected_image expected_id actual_id restart_before restart_after
  wait_service analyzer zenvis-service-analyzer || { analyzer_compose ps -a; return 1; }
  wait_http http://127.0.0.1:18080/healthz 'ZenVis Analyzer liveness' || return 1
  wait_http http://127.0.0.1:18080/readyz 'ZenVis Analyzer readiness' || return 1
  container=$(analyzer_compose ps -q zenvis-service-analyzer)
  expected_image=$(env_value "$ANALYZER_IMAGE_ENV" ANALYZER_IMAGE)
  expected_id=$(docker image inspect --format '{{.Id}}' "$expected_image")
  actual_id=$(docker inspect --format '{{.Image}}' "$container")
  [[ "$actual_id" == "$expected_id" ]] || {
    log "Analyzer 容器镜像不一致：expected=$expected_id actual=$actual_id" >&2
    return 1
  }
  restart_before=$(docker inspect --format '{{.RestartCount}}' "$container")
  sleep 10
  restart_after=$(docker inspect --format '{{.RestartCount}}' "$container")
  [[ "$restart_after" == "$restart_before" ]] || {
    log "Analyzer 稳定观察期内发生重启：$restart_before -> $restart_after" >&2
    return 1
  }
}

start_saved_containers() {
  local backup_dir=$1 containers=()
  [[ -f "$backup_dir/running-containers.tsv" ]] || return 0
  mapfile -t containers < <(awk -F '\t' 'NF == 2 {print $2}' "$backup_dir/running-containers.tsv")
  if (( ${#containers[@]} > 0 )); then
    docker start "${containers[@]}" >/dev/null
  fi
}

create_zenvis_backup() {
  local backup_id backup_dir running service container
  backup_id="compose-$(date '+%Y%m%d-%H%M%S')"
  backup_dir="$STATE_ROOT/backups/zenvis/$backup_id"
  mkdir "$backup_dir" || die "ZenVis 备份 ID 冲突：$backup_id"
  running=$(zenvis_compose ps --services --filter status=running || true)
  printf '%s\n' "$running" >"$backup_dir/running-services.txt"
  : >"$backup_dir/running-containers.tsv"
  while IFS= read -r service; do
    container=$(zenvis_compose ps -q "$service")
    [[ -n "$container" ]] && printf '%s\t%s\n' "$service" "$container" >>"$backup_dir/running-containers.tsv"
  done <<<"$running"
  zenvis_compose config >"$backup_dir/compose-config.yml"
  cp "$ZENVIS_ENV" "$backup_dir/env.before"
  cp "$ZENVIS_IMAGE_ENV" "$backup_dir/images.before"
  cp "$ZENVIS_SOURCE_ENV" "$backup_dir/source.before"
  log "停止 ZenVis 服务并创建一致性备份：$backup_id"
  zenvis_compose stop
  trap 'start_saved_containers "$backup_dir" || true' EXIT
  trap 'start_saved_containers "$backup_dir" || true; exit 130' INT
  trap 'start_saved_containers "$backup_dir" || true; exit 143' TERM
  if ! docker run --rm -v "$ZENVIS_REPO/deploy:/source:ro" alpine:3.22 \
      tar -cf - -C /source .env open_config data \
      | gzip >"$backup_dir/payload.tar.gz"; then
    start_saved_containers "$backup_dir" || true
    verify_zenvis_stack || true
    die "ZenVis 备份失败"
  fi
  start_saved_containers "$backup_dir"
  trap - EXIT INT TERM
  gzip -t "$backup_dir/payload.tar.gz" || die "ZenVis 备份压缩包校验失败"
  sha256sum "$backup_dir/payload.tar.gz" "$backup_dir/images.before" \
    "$backup_dir/source.before" "$backup_dir/compose-config.yml" >"$backup_dir/SHA256SUMS"
  verify_zenvis_stack || die "ZenVis 备份后未能恢复服务"
  chmod -R go-rwx "$backup_dir"
  CREATED_BACKUP_ID="$backup_id"
}

recover_zenvis_restore_state() {
  local safety=$1 failed ids=() path
  trap - EXIT INT TERM
  mapfile -t ids < <(docker ps -aq --filter label=com.docker.compose.project=zenvis)
  (( ${#ids[@]} == 0 )) || docker stop "${ids[@]}" >/dev/null || true
  failed="$STATE_ROOT/backups/zenvis/failed-restore-$(date '+%Y%m%d-%H%M%S')"
  mkdir -p "$failed"
  for path in data open_config .env; do
    if [[ -e "$safety/$path" ]]; then
      [[ -e "$ZENVIS_REPO/deploy/$path" ]] && mv "$ZENVIS_REPO/deploy/$path" "$failed/"
      mv "$safety/$path" "$ZENVIS_REPO/deploy/"
    fi
  done
  [[ -f "$safety/images.current" ]] && cp "$safety/images.current" "$ZENVIS_IMAGE_ENV"
  [[ -f "$safety/source.current" ]] && cp "$safety/source.current" "$ZENVIS_SOURCE_ENV"
  chmod 600 "$ZENVIS_ENV" "$ZENVIS_IMAGE_ENV" "$ZENVIS_SOURCE_ENV" || true
  if zenvis_compose config --quiet && zenvis_compose up -d && verify_zenvis_stack; then
    log "ZenVis 恢复操作失败，已恢复操作前状态；失败内容位于 $failed" >&2
  else
    log "ZenVis 恢复操作失败且操作前 Compose 未能自动启动；服务保持停机，请检查 $safety 与 $failed" >&2
  fi
}

restore_zenvis_backup() {
  local backup_id=$1 backup_dir safety staging current_ids=()
  [[ "$backup_id" =~ ^compose-[0-9]{8}-[0-9]{6}$ ]] || die "非法备份 ID：$backup_id"
  backup_dir="$STATE_ROOT/backups/zenvis/$backup_id"
  [[ -f "$backup_dir/payload.tar.gz" ]] || die "ZenVis 备份不存在：$backup_id"
  (cd "$backup_dir" && sha256sum -c SHA256SUMS)
  staging=$(mktemp -d "$STATE_ROOT/backups/zenvis/.restore-staging.XXXXXX")
  if ! gzip -dc "$backup_dir/payload.tar.gz" \
      | docker run --rm -i -v "$staging:/target" alpine:3.22 tar -xf - -C /target; then
    rm -rf "$staging"
    die "ZenVis 备份无法完整解包，未触碰运行数据"
  fi
  [[ -f "$staging/.env" && -d "$staging/data" && -d "$staging/open_config" ]] \
    || { rm -rf "$staging"; die "ZenVis 备份结构不完整，未触碰运行数据"; }
  mapfile -t current_ids < <(docker ps -aq --filter label=com.docker.compose.project=zenvis)
  (( ${#current_ids[@]} > 0 )) || { rm -rf "$staging"; die "未找到 ZenVis 项目容器，拒绝移动数据"; }
  safety="$STATE_ROOT/backups/zenvis/rollback-safety-$(date '+%Y%m%d-%H%M%S')"
  mkdir -p "$safety"
  cp "$ZENVIS_IMAGE_ENV" "$safety/images.current"
  cp "$ZENVIS_SOURCE_ENV" "$safety/source.current"
  trap 'recover_zenvis_restore_state "$safety"' EXIT
  trap 'recover_zenvis_restore_state "$safety"; exit 130' INT
  trap 'recover_zenvis_restore_state "$safety"; exit 143' TERM
  docker stop "${current_ids[@]}" >/dev/null
  for path in data open_config .env; do
    [[ -e "$ZENVIS_REPO/deploy/$path" ]] && mv "$ZENVIS_REPO/deploy/$path" "$safety/"
  done
  mv "$staging/.env" "$staging/data" "$staging/open_config" "$ZENVIS_REPO/deploy/"
  rm -rf "$staging"
  cp "$backup_dir/images.before" "$ZENVIS_IMAGE_ENV"
  if [[ -f "$backup_dir/source.before" ]]; then
    cp "$backup_dir/source.before" "$ZENVIS_SOURCE_ENV"
  else
    printf 'ZENVIS_SOURCE_DIR=%s\n' "$ZENVIS_REPO" >"$ZENVIS_SOURCE_ENV"
  fi
  chmod 600 "$ZENVIS_ENV" "$ZENVIS_IMAGE_ENV" "$ZENVIS_SOURCE_ENV"
  if ! zenvis_compose config --quiet || ! zenvis_compose up -d || ! verify_zenvis_stack; then
    recover_zenvis_restore_state "$safety"
    die "ZenVis 备份恢复失败"
  fi
  trap - EXIT INT TERM
  log "已恢复 ZenVis 备份 $backup_id；回滚前文件位于 $safety"
}

create_agent_backup() {
  local keep_stopped=${1:-false} backup_id backup_dir mysql_id running service container
  [[ "$keep_stopped" == true || "$keep_stopped" == false ]] || die "非法 Agent 备份事务模式"
  backup_id="agent-$(date '+%Y%m%d-%H%M%S')"
  backup_dir="$STATE_ROOT/backups/agent/$backup_id"
  mkdir "$backup_dir" || die "Agent 备份 ID 冲突：$backup_id"
  mysql_id=$(agent_compose ps -q mysql)
  [[ -n "$mysql_id" ]] || die "Agent MySQL 未运行"
  running=$(agent_compose ps --services --filter status=running || true)
  printf '%s\n' "$running" >"$backup_dir/running-services.txt"
  : >"$backup_dir/running-containers.tsv"
  while IFS= read -r service; do
    container=$(agent_compose ps -q "$service")
    [[ -n "$container" ]] && printf '%s\t%s\n' "$service" "$container" >>"$backup_dir/running-containers.tsv"
  done <<<"$running"
  log "短暂停止 Agent 应用写入并创建 MySQL + workspace 一致性备份：$backup_id"
  agent_compose stop frontend backend tool-executor-local tool-executor-standard tool-executor-privileged
  STOPPED_AGENT_BACKUP_DIR=$backup_dir
  trap 'start_saved_containers "$STOPPED_AGENT_BACKUP_DIR" || true' EXIT
  trap 'start_saved_containers "$STOPPED_AGENT_BACKUP_DIR" || true; exit 130' INT
  trap 'start_saved_containers "$STOPPED_AGENT_BACKUP_DIR" || true; exit 143' TERM
  if ! docker exec "$mysql_id" sh -c \
      'exec mysqldump --single-transaction --routines --events --triggers --no-tablespaces -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" "$MYSQL_DATABASE"' \
      | gzip >"$backup_dir/mysql.sql.gz"; then
    start_saved_containers "$backup_dir" || true
    die "Agent MySQL 备份失败"
  fi
  if ! docker run --rm -v lubinsun-test_agent-data:/source:ro alpine:3.22 \
      tar -cf - -C /source . | gzip >"$backup_dir/workspace.tar.gz"; then
    start_saved_containers "$backup_dir" || true
    die "Agent workspace 备份失败"
  fi
  gzip -t "$backup_dir/mysql.sql.gz"
  gzip -t "$backup_dir/workspace.tar.gz"
  cp "$AGENT_IMAGE_ENV" "$backup_dir/images.before"
  cp "$AGENT_RUNTIME_ENV" "$backup_dir/runtime.before"
  cp "$AGENT_SOURCE_ENV" "$backup_dir/source.before"
  cp "$BASELINE_MIGRATION_MANIFEST" "$backup_dir/migrations.before.sha256"
  agent_compose config --no-interpolate >"$backup_dir/compose-config.yml"
  docker inspect lubinsun-test-mysql-1 lubinsun-test-tool-executor-local-1 lubinsun-test-tool-executor-standard-1 lubinsun-test-tool-executor-privileged-1 lubinsun-test-backend-1 lubinsun-test-frontend-1 \
    | jq '[.[] | {Name,Image,Config:{Image:.Config.Image,Labels:.Config.Labels,User:.Config.User},HostConfig:{NetworkMode,PortBindings,RestartPolicy},Mounts}]' >"$backup_dir/containers.before.json"
  sha256sum "$backup_dir/mysql.sql.gz" "$backup_dir/workspace.tar.gz" "$backup_dir/images.before" \
    "$backup_dir/runtime.before" "$backup_dir/source.before" \
    "$backup_dir/migrations.before.sha256" \
    "$backup_dir/compose-config.yml" "$backup_dir/containers.before.json" >"$backup_dir/SHA256SUMS"
  chmod -R go-rwx "$backup_dir"
  CREATED_BACKUP_ID="$backup_id"
  if [[ "$keep_stopped" == false ]]; then
    start_saved_containers "$backup_dir"
    trap - EXIT INT TERM
    unset STOPPED_AGENT_BACKUP_DIR
    VERIFY_MIGRATION_MANIFEST_OVERRIDE="${BASELINE_MIGRATION_MANIFEST:-}" verify_agent_stack \
      || die "Agent 备份后未能恢复服务"
  fi
}

