api_token() {
  local token
  token=$(env_value "$ZENVIS_ENV" API_BEARER_TOKEN)
  [[ -n "$token" ]] || die "ZenVis API_BEARER_TOKEN 未配置"
  printf '%s' "$token"
}

plugin_request() {
  local method=$1 path=$2 token=$3 data=${4:-}
  if [[ -n "$data" ]]; then
    curl -fsS -X "$method" -H "Authorization: Bearer $token" -H 'Content-Type: application/json' \
      --data "$data" "http://127.0.0.1:11001$path"
  else
    curl -fsS -X "$method" -H "Authorization: Bearer $token" "http://127.0.0.1:11001$path"
  fi
}

wait_plugin_installed() {
  local id=$1 token=$2 response status
  for ((attempt=1; attempt<=180; attempt++)); do
    response=$(plugin_request GET "/api/v1/system/plugin/$id/view" "$token")
    [[ "$(jq -r '.status' <<<"$response")" == 0 ]] || return 1
    status=$(jq -r '.data.status' <<<"$response")
    case "$status" in
      INSTALLED) return 0 ;;
      INSTALL_FAILED|UPGRADE_FAILED|UNINSTALL_FAILED) return 1 ;;
    esac
    sleep 2
  done
  return 1
}

deploy_plugin() {
  local component=$1 sha=$2 repository=$3 token package_file package_version package_digest backup_id
  local list_response plugin_id current_version upload_response candidate_path request response
  build_plugin
  package_file="$COMPONENT_SOURCE_DIR/${PLUGIN_PACKAGE//./-}.tar.gz"
  [[ -f "$package_file" ]] || die "插件包不存在：$package_file"
  package_version=$(jq -r '.version' "$COMPONENT_SOURCE_DIR/$PLUGIN_DIRECTORY/index.json")
  package_digest=$(sha256sum "$package_file" | awk '{print $1}')
  token=$(api_token)
  list_response=$(plugin_request GET '/api/v1/system/plugin/list?page=1&per_page=200' "$token")
  plugin_id=$(jq -r --arg package "$PLUGIN_PACKAGE" \
    '.data.rows[]? | select(.package_name == $package) | .id' <<<"$list_response" | head -n 1)
  [[ "$plugin_id" =~ ^[0-9]+$ ]] || die "未找到已安装插件：$PLUGIN_PACKAGE"
  current_version=$(jq -r --arg package "$PLUGIN_PACKAGE" \
    '.data.rows[]? | select(.package_name == $package) | .version' <<<"$list_response" | head -n 1)
  [[ "$current_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([-.][A-Za-z0-9.-]+)?$ ]] \
    || die "当前插件版本格式异常：$current_version"
  create_zenvis_backup
  backup_id="$CREATED_BACKUP_ID"
  upload_response=$(curl -fsS -H "Authorization: Bearer $token" -F "file=@$package_file" \
    http://127.0.0.1:11001/api/v1/system/plugin/upload)
  [[ "$(jq -r '.status' <<<"$upload_response")" == 0 ]] || {
    restore_zenvis_backup "$backup_id"; die "插件上传失败";
  }
  candidate_path=$(jq -r '.data.plugin_path' <<<"$upload_response")
  [[ -n "$candidate_path" && "$candidate_path" != null ]] || {
    restore_zenvis_backup "$backup_id"; die "插件上传响应缺少 plugin_path";
  }
  if [[ "$(printf '%s\n%s\n' "$package_version" "$current_version" | sort -V | tail -n 1)" != "$package_version" \
      || "$package_version" == "$current_version" ]]; then
    stage_plugin_version "$plugin_id" "$PLUGIN_PACKAGE" "$current_version" 0.0.0
    log "通过受控元数据暂存安装原始 main 包：$current_version -> $package_version"
  fi
  request=$(jq -cn --arg path "$candidate_path" '{plugin_path:$path}')
  response=$(plugin_request POST "/api/v1/system/plugin/$plugin_id/upgrade" "$token" "$request")
  if [[ "$(jq -r '.status' <<<"$response")" != 0 ]] || ! wait_plugin_installed "$plugin_id" "$token"; then
    plugin_request POST "/api/v1/system/plugin/$plugin_id/upgrade/recover" "$token" >/dev/null || true
    restore_zenvis_backup "$backup_id"
    die "插件升级失败，已恢复 ZenVis 一致性备份"
  fi
  response=$(plugin_request GET "/api/v1/system/plugin/$plugin_id/view" "$token")
  [[ "$(jq -r '.data.version' <<<"$response")" == "$package_version" ]] || {
    restore_zenvis_backup "$backup_id"; die "插件运行版本与包版本不一致";
  }
  if ! curl -fsS -H "Authorization: Bearer $token" "http://127.0.0.1:11001$PLUGIN_SMOKE_PATH" >/dev/null; then
    restore_zenvis_backup "$backup_id"
    die "插件业务健康检查失败，已恢复 ZenVis 一致性备份"
  fi
  write_manifest "$component" "$sha" "$repository" "$PLUGIN_PACKAGE:$package_version" "sha256:$package_digest" "$backup_id"
  record_zenvis_head "$component" "$sha"
}

stage_plugin_version() {
  local plugin_id=$1 package=$2 expected=$3 target=$4 mysql_id sql actual
  [[ "$plugin_id" =~ ^[0-9]+$ ]] || die "非法插件 ID"
  [[ "$package" =~ ^[a-z0-9.]+$ ]] || die "非法插件包名"
  [[ "$expected" =~ ^[A-Za-z0-9.-]+$ && "$target" =~ ^[A-Za-z0-9.-]+$ ]] || die "非法插件版本"
  mysql_id=$(zenvis_compose ps -q mysql-service)
  [[ -n "$mysql_id" ]] || die "ZenVis MySQL 未运行"
  sql="UPDATE t_sys_plugin SET version='$target' WHERE id=$plugin_id AND package_name='$package' AND version='$expected' AND status='INSTALLED';"
  docker exec "$mysql_id" sh -c 'exec mysql -N -B -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" "$MYSQL_DATABASE" -e "$1"' sh "$sql" >/dev/null
  sql="SELECT version FROM t_sys_plugin WHERE id=$plugin_id AND package_name='$package';"
  actual=$(docker exec "$mysql_id" sh -c 'exec mysql -N -B -u"$MYSQL_USER" -p"$MYSQL_PASSWORD" "$MYSQL_DATABASE" -e "$1"' sh "$sql")
  [[ "$actual" == "$target" ]] || die "插件版本元数据暂存失败"
}

validate_agent_backend() {
  local cache="$STATE_ROOT/cache/agent-go"
  mkdir -p "$cache"
  docker run --rm --user "$(id -u):$(id -g)" \
    -e HOME=/tmp/go-home -e GOCACHE=/cache/build -e GOMODCACHE=/cache/mod \
    -e GOPROXY="$GO_PROXY" -v "$cache:/cache" -v "$COMPONENT_SOURCE_DIR:/workspace" \
    -w /workspace/backend golang:1.26.5-bookworm bash -euc 'go test ./... && go build ./cmd/server'
}

validate_agent_frontend() {
  local cache="$STATE_ROOT/cache/agent-npm"
  mkdir -p "$cache"
  docker run --rm --user "$(id -u):$(id -g)" \
    -e HOME=/tmp/node-home -e npm_config_cache=/cache \
    -v "$cache:/cache" -v "$COMPONENT_SOURCE_DIR:/workspace" \
    -w /workspace/frontend node:22-bookworm bash -euc 'npm ci && npm run build && test -s dist/index.html'
}

deploy_agent() {
  local revision=$1 repository=$2 backend_image frontend_image old_backend old_frontend old_source backup_id=''
  local existing_backend existing_frontend
  local backend_changed=true frontend_changed=true stack_changed=true current target_images service needs_backup=false
  local changed_services=()
  ensure_agent_runtime
  old_source=$(agent_source_dir)
  existing_backend=$(env_value "$AGENT_IMAGE_ENV" BACKEND_IMAGE)
  existing_frontend=$(env_value "$AGENT_IMAGE_ENV" FRONTEND_IMAGE)
  old_backend=$(preserve_container_image lubinsun-test-backend-1 agent-backend)
  old_frontend=$(preserve_container_image lubinsun-test-frontend-1 agent-frontend)
  prepare_agent_migrations
  current="$STATE_ROOT/components/lubinsun-agent/current.env"

  if [[ "$(container_source_digest lubinsun-test-backend-1)" == "$AGENT_BACKEND_DIGEST" \
      && "$(container_source_digest lubinsun-test-tool-executor-local-1)" == "$AGENT_BACKEND_DIGEST" \
      && "$(container_source_digest lubinsun-test-tool-executor-standard-1)" == "$AGENT_BACKEND_DIGEST" \
      && "$(container_source_digest lubinsun-test-tool-executor-privileged-1)" == "$AGENT_BACKEND_DIGEST" ]]; then
    backend_changed=false
  fi
  if [[ "$(container_source_digest lubinsun-test-frontend-1)" == "$AGENT_FRONTEND_DIGEST" ]]; then
    frontend_changed=false
  fi
  if [[ "$(manifest_value "$current" agent_stack_digest)" == "$AGENT_STACK_DIGEST" ]]; then
    stack_changed=false
  fi

  backend_image=$existing_backend
  frontend_image=$existing_frontend
  if [[ "$backend_changed" == true ]]; then
    validate_agent_backend
    backend_image="lubinsun/lubinsun-agent-backend:src-$AGENT_BACKEND_DIGEST"
    if ! reuse_image_if_present "$backend_image" "$AGENT_BACKEND_DIGEST"; then
      docker build \
        --label "org.opencontainers.image.revision=$revision" \
        --label "org.opencontainers.image.source-digest=$AGENT_BACKEND_DIGEST" \
        --label "org.opencontainers.image.source=https://github.com/$COMPONENT_GITHUB" \
        -f "$COMPONENT_SOURCE_DIR/deploy/backend.Dockerfile" -t "$backend_image" "$COMPONENT_SOURCE_DIR"
      verify_image_metadata "$backend_image" "$revision" "$AGENT_BACKEND_DIGEST"
    fi
    verify_agent_image_migrations "$backend_image"
  fi
  if [[ "$frontend_changed" == true ]]; then
    validate_agent_frontend
    frontend_image="lubinsun/lubinsun-agent-frontend:src-$AGENT_FRONTEND_DIGEST"
    if ! reuse_image_if_present "$frontend_image" "$AGENT_FRONTEND_DIGEST"; then
      docker build \
        --label "org.opencontainers.image.revision=$revision" \
        --label "org.opencontainers.image.source-digest=$AGENT_FRONTEND_DIGEST" \
        --label "org.opencontainers.image.source=https://github.com/$COMPONENT_GITHUB" \
        -f "$COMPONENT_SOURCE_DIR/deploy/frontend.Dockerfile" -t "$frontend_image" "$COMPONENT_SOURCE_DIR"
      verify_image_metadata "$frontend_image" "$revision" "$AGENT_FRONTEND_DIGEST"
    fi
  fi

  target_images=$(mktemp "$STATE_ROOT/agent-target-images.XXXXXX")
  {
    printf 'BACKEND_IMAGE=%s\n' "$backend_image"
    printf 'FRONTEND_IMAGE=%s\n' "$frontend_image"
  } >"$target_images"
  chmod 600 "$target_images"
  agent_compose_for "$COMPONENT_SOURCE_DIR" "$target_images" config --quiet
  mapfile -t changed_services < <(agent_target_changed_services "$COMPONENT_SOURCE_DIR" "$target_images")
  if (( ${#changed_services[@]} == 0 )); then
    changed_services=(tool-executor-local tool-executor-standard tool-executor-privileged backend frontend)
  fi
  for service in "${changed_services[@]}"; do
    [[ "$service" == frontend ]] || needs_backup=true
  done

  if [[ "$needs_backup" == true ]]; then
    set_env_key "$AGENT_IMAGE_ENV" BACKEND_IMAGE "$old_backend"
    set_env_key "$AGENT_IMAGE_ENV" FRONTEND_IMAGE "$old_frontend"
    create_agent_backup true
    backup_id="$CREATED_BACKUP_ID"
  fi

  set_env_key "$AGENT_IMAGE_ENV" BACKEND_IMAGE "$backend_image"
  set_env_key "$AGENT_IMAGE_ENV" FRONTEND_IMAGE "$frontend_image"
  set_env_key "$AGENT_SOURCE_ENV" AGENT_SOURCE_DIR "$COMPONENT_SOURCE_DIR"
  if ! assert_agent_compose_invariants || ! agent_compose config --quiet; then
    set_env_key "$AGENT_IMAGE_ENV" BACKEND_IMAGE "$old_backend"
    set_env_key "$AGENT_IMAGE_ENV" FRONTEND_IMAGE "$old_frontend"
    set_env_key "$AGENT_SOURCE_ENV" AGENT_SOURCE_DIR "$old_source"
    rm -f "$target_images" "$PENDING_MIGRATION_MANIFEST"
    die "Lubinsun Agent 目标 Compose 校验失败，未修改运行容器"
  fi
  rm -f "$target_images"

  local apply_failed=false
  if [[ "$needs_backup" == true ]]; then
    agent_compose up -d --no-build mysql tool-executor-local tool-executor-standard \
      tool-executor-privileged backend frontend || apply_failed=true
  else
    agent_compose up -d --no-deps --no-build "${changed_services[@]}" || apply_failed=true
  fi
  if [[ "$apply_failed" == true ]] || ! verify_agent_stack \
      || ! all_service_configs_match agent mysql tool-executor-local tool-executor-standard \
        tool-executor-privileged backend frontend \
      || ! verify_running_image lubinsun-test-backend-1 "$backend_image" "$AGENT_BACKEND_DIGEST" \
      || ! verify_running_image lubinsun-test-tool-executor-local-1 "$backend_image" "$AGENT_BACKEND_DIGEST" \
      || ! verify_running_image lubinsun-test-tool-executor-standard-1 "$backend_image" "$AGENT_BACKEND_DIGEST" \
      || ! verify_running_image lubinsun-test-tool-executor-privileged-1 "$backend_image" "$AGENT_BACKEND_DIGEST" \
      || ! verify_running_image lubinsun-test-frontend-1 "$frontend_image" "$AGENT_FRONTEND_DIGEST"; then
    trap - EXIT INT TERM
    if [[ -n "$backup_id" ]]; then
      if ! restore_agent_data_backup "$backup_id"; then
        rm -f "$PENDING_MIGRATION_MANIFEST"
        die "Lubinsun Agent 部署失败且配对数据恢复失败；服务保持停机，恢复点为 $backup_id"
      fi
    fi
    set_env_key "$AGENT_IMAGE_ENV" BACKEND_IMAGE "$old_backend"
    set_env_key "$AGENT_IMAGE_ENV" FRONTEND_IMAGE "$old_frontend"
    set_env_key "$AGENT_SOURCE_ENV" AGENT_SOURCE_DIR "$old_source"
    agent_compose up -d --no-build mysql tool-executor-local tool-executor-standard tool-executor-privileged backend frontend || true
    VERIFY_MIGRATION_MANIFEST_OVERRIDE="$BASELINE_MIGRATION_MANIFEST" verify_agent_stack || true
    rm -f "$PENDING_MIGRATION_MANIFEST"
    die "Lubinsun Agent 部署失败，旧镜像、MySQL 与 workspace 已恢复；一致性备份为 ${backup_id:-无需备份}"
  fi
  [[ "$needs_backup" == false ]] || { trap - EXIT INT TERM; unset STOPPED_AGENT_BACKUP_DIR; }
  commit_agent_migrations "$revision"
  write_manifest lubinsun-agent "$revision" "$repository" "$backend_image" "$frontend_image" "$backup_id" \
    "$old_backend" "$old_frontend" "$old_source"
  rm -f "$PENDING_MIGRATION_MANIFEST"
  unset PENDING_MIGRATION_MANIFEST BASELINE_MIGRATION_MANIFEST
}

deploy_locked() {
  local component=$1 repository=$2 sha=$3 prepare_status=0
  component_config "$component"
  case "$component" in
    plugin-lubinsun|plugin-onesoc)
      die "插件由 ZenVis 页面手动上传；统一控制器不执行插件部署"
      ;;
  esac
  [[ "$repository" == "$COMPONENT_GITHUB" ]] || die "仓库参数与 component 不匹配"
  doctor
  prepare_remote_source "$COMPONENT_REPO" "$COMPONENT_GITHUB" "$sha" || prepare_status=$?
  [[ "$prepare_status" == 0 ]] || { [[ "$prepare_status" == 20 ]] && return 0; return "$prepare_status"; }
  if component_runtime_matches "$component"; then
    if verify_component_runtime "$component"; then
      write_verification "$component" no-op
      log "服务器实际版本已一致，跳过构建和容器重建：component=$component revision=$SOURCE_REVISION digest=$SOURCE_DIGEST"
      return 0
    fi
    log "版本摘要一致但运行校验失败，将执行修复性部署：component=$component"
  fi
  case "$component" in
    zenvis) deploy_zenvis "$SOURCE_REVISION" "$repository" ;;
    zenvis-backend) deploy_zenvis_backend "$SOURCE_REVISION" "$repository" ;;
    zenvis-frontend) deploy_zenvis_frontend "$SOURCE_REVISION" "$repository" ;;
    zenvis-analyzer) deploy_zenvis_analyzer "$SOURCE_REVISION" "$repository" ;;
    plugin-onesoc|plugin-lubinsun) deploy_plugin "$component" "$SOURCE_REVISION" "$repository" ;;
    lubinsun-agent) deploy_agent "$SOURCE_REVISION" "$repository" ;;
  esac
  component_runtime_matches "$component" || die "部署后台账与实际运行版本不一致"
  verify_component_runtime "$component" || die "部署后最终运行校验失败"
  write_verification "$component" deployed
  rm -f "$STATE_ROOT/components/$component/rollback.once"
  log "部署成功：component=$component revision=$SOURCE_REVISION digest=$SOURCE_DIGEST"
}

deploy_local_locked() {
  local component=$1
  case "$component" in
    zenvis|zenvis-backend|zenvis-frontend|zenvis-analyzer|lubinsun-agent) ;;
    *) die "deploy-local 仅支持 ZenVis 编排、前后端、Analyzer 与 Lubinsun Agent；插件继续走发布包手动上传" ;;
  esac
  component_config "$component"
  doctor
  prepare_local_source "$COMPONENT_REPO"
  if component_runtime_matches "$component" && verify_component_runtime "$component"; then
    write_verification "$component" no-op
    log "本地源码内容与服务器实际版本一致，跳过构建和容器重建：component=$component digest=$SOURCE_DIGEST"
    return 0
  fi
  case "$component" in
    zenvis) deploy_zenvis "$SOURCE_REVISION" "$COMPONENT_GITHUB" ;;
    zenvis-backend) deploy_zenvis_backend "$SOURCE_REVISION" "$COMPONENT_GITHUB" ;;
    zenvis-frontend) deploy_zenvis_frontend "$SOURCE_REVISION" "$COMPONENT_GITHUB" ;;
    zenvis-analyzer) deploy_zenvis_analyzer "$SOURCE_REVISION" "$COMPONENT_GITHUB" ;;
    lubinsun-agent) deploy_agent "$SOURCE_REVISION" "$COMPONENT_GITHUB" ;;
  esac
  component_runtime_matches "$component" || die "本地部署后台账与实际运行版本不一致"
  verify_component_runtime "$component" || die "本地部署后最终运行校验失败"
  write_verification "$component" deployed
  rm -f "$STATE_ROOT/components/$component/rollback.once"
  log "本地部署成功：component=$component digest=$SOURCE_DIGEST"
}

rollback_locked() {
  local component=$1 current previous target current_sha backup_id temp analyzer_backup
  local target_image_a target_image_b target_source target_digest target_backend_digest target_frontend_digest
  local target_stack_digest target_migrations target_backup source_before safety_backup db_versions target_versions
  component_config "$component"
  current="$STATE_ROOT/components/$component/current.env"
  previous="$STATE_ROOT/components/$component/previous.env"
  [[ -f "$current" ]] || die "$component 没有可回滚的当前发布"
  [[ ! -f "$STATE_ROOT/components/$component/rollback.once" ]] \
    || die "$component 已执行过一次回滚；如需重新应用 previous，请执行 deploy/deploy-local 创建新发布"
  backup_id=$(manifest_value "$current" backup_id)
  current_sha=$(manifest_value "$current" sha)
  if [[ -f "$previous" ]]; then
    target=$previous
    target_image_a=$(manifest_value "$target" image_a)
    target_image_b=$(manifest_value "$target" image_b)
    target_source=$(manifest_value "$target" source_dir)
    target_digest=$(manifest_value "$target" source_digest)
    target_backend_digest=$(manifest_value "$target" agent_backend_digest)
    target_frontend_digest=$(manifest_value "$target" agent_frontend_digest)
    target_stack_digest=$(manifest_value "$target" agent_stack_digest)
    target_migrations=$(manifest_value "$target" migration_manifest)
  else
    target=$current
    target_image_a=$(manifest_value "$current" rollback_image_a)
    target_image_b=$(manifest_value "$current" rollback_image_b)
    target_source=$(manifest_value "$current" rollback_source_dir)
    target_digest=''
    target_backend_digest=''
    target_frontend_digest=''
    target_stack_digest=''
  fi
  case "$component" in
    plugin-onesoc|plugin-lubinsun)
      die "插件由 ZenVis 手动上传管理，不由统一控制器执行自动回滚"
      ;;
    zenvis)
      [[ -n "$backup_id" ]] || die "$component 当前发布没有一致性备份"
      assert_latest_zenvis_release "$component" "$current_sha"
      source_before=$(env_value "$STATE_ROOT/backups/zenvis/$backup_id/source.before" ZENVIS_SOURCE_DIR)
      [[ -z "$target_source" || -z "$source_before" || "$target_source" == "$source_before" ]] \
        || die "该发布的备份不对应 previous 目标，拒绝连续数据回滚"
      restore_zenvis_backup "$backup_id"
      ;;
    zenvis-backend)
      [[ -n "$target_image_a" && -n "$backup_id" ]] || die "当前发布缺少 Backend 回滚镜像或备份"
      assert_latest_zenvis_release "$component" "$current_sha"
      local backed_up_backend
      backed_up_backend=$(env_value "$STATE_ROOT/backups/zenvis/$backup_id/images.before" ZENVIS_BACKEND_IMAGE)
      [[ "$(docker image inspect --format '{{.Id}}' "$backed_up_backend")" == \
        "$(docker image inspect --format '{{.Id}}' "$target_image_a")" ]] \
        || die "Backend 前置备份不对应 previous 目标，拒绝回滚"
      restore_zenvis_backup "$backup_id"
      set_env_key "$ZENVIS_IMAGE_ENV" ZENVIS_BACKEND_IMAGE "$target_image_a"
      zenvis_compose up -d --no-deps zenvis-backend
      verify_zenvis_backend
      verify_running_ref zenvis-backend "$target_image_a" "$target_digest"
      ;;
    zenvis-frontend)
      [[ -n "$target_image_a" ]] || die "当前发布缺少 Frontend 回滚镜像"
      set_env_key "$ZENVIS_IMAGE_ENV" ZENVIS_FRONTEND_IMAGE "$target_image_a"
      zenvis_compose up -d --no-deps zenvis-frontend
      wait_http http://127.0.0.1:11000/ 'ZenVis Web rollback'
      verify_running_ref zenvis-frontend "$target_image_a" "$target_digest"
      ;;
    zenvis-analyzer)
      [[ -n "$target_image_a" ]] || die "当前发布缺少 Analyzer 回滚镜像"
      [[ "$backup_id" =~ ^analyzer-[0-9]{8}-[0-9]{6}$ ]] || die "当前发布缺少 Analyzer 配置备份"
      analyzer_backup="$STATE_ROOT/backups/analyzer/$backup_id"
      [[ -f "$analyzer_backup/SHA256SUMS" ]] || die "Analyzer 配置备份不存在"
      sha256sum -c "$analyzer_backup/SHA256SUMS" >/dev/null
      [[ -z "$(manifest_value "$target" zones_digest)" || \
        "$(sha256sum "$analyzer_backup/zones.json.before" | awk '{print $1}')" == \
        "$(manifest_value "$target" zones_digest)" ]] \
        || die "Analyzer 前置备份不对应 previous 区域配置，拒绝回滚"
      install -m 0644 "$analyzer_backup/zones.json.before" "$ANALYZER_ZONE_FILE"
      set_env_key "$ANALYZER_IMAGE_ENV" ANALYZER_IMAGE "$target_image_a"
      [[ -n "$target_source" ]] && set_env_key "$ANALYZER_SOURCE_ENV" ANALYZER_SOURCE_DIR "$target_source"
      analyzer_compose up -d --no-deps zenvis-service-analyzer
      verify_analyzer_stack
      verify_running_ref zenvis-service-analyzer "$target_image_a" "$target_digest"
      [[ -z "$(manifest_value "$target" zones_digest)" || \
        "$(sha256sum "$ANALYZER_ZONE_FILE" | awk '{print $1}')" == "$(manifest_value "$target" zones_digest)" ]]
      ;;
    lubinsun-agent)
      [[ -n "$target_image_a" && -n "$target_image_b" && -n "$target_source" ]] \
        || die "当前发布缺少 Agent 回滚镜像或源码快照"
      [[ -n "$target_migrations" && -f "$target_migrations" ]] \
        || target_migrations="$STATE_ROOT/backups/agent/$backup_id/migrations.before.sha256"
      [[ -f "$target_migrations" ]] || die "Agent 回滚目标缺少 migration 清单"
      BASELINE_MIGRATION_MANIFEST=$(manifest_value "$current" migration_manifest)
      [[ -f "$BASELINE_MIGRATION_MANIFEST" ]] || die "Agent 当前 migration 清单不存在"
      create_agent_backup true
      safety_backup="$CREATED_BACKUP_ID"
      db_versions=$(mktemp "$STATE_ROOT/rollback-db.XXXXXX")
      target_versions=$(mktemp "$STATE_ROOT/rollback-target.XXXXXX")
      agent_db_migrations >"$db_versions"
      awk '{print $2}' "$target_migrations" | LC_ALL=C sort >"$target_versions"
      if [[ -n "$(comm -23 "$db_versions" "$target_versions")" ]]; then
        [[ -n "$backup_id" ]] || die "Agent 回滚需要恢复数据，但当前发布没有前置备份"
        if ! restore_agent_data_backup "$backup_id"; then
          trap - EXIT INT TERM
          restore_agent_data_backup "$safety_backup" \
            || die "Agent 目标数据恢复失败，且 rollback-safety 恢复也失败；服务保持停机，安全备份为 $safety_backup"
          cp "$STATE_ROOT/backups/agent/$safety_backup/images.before" "$AGENT_IMAGE_ENV"
          cp "$STATE_ROOT/backups/agent/$safety_backup/source.before" "$AGENT_SOURCE_ENV"
          agent_compose up -d --no-build || true
          die "Agent 目标数据恢复失败，已尝试恢复回滚安全备份 $safety_backup"
        fi
      fi
      rm -f "$db_versions" "$target_versions"
      set_env_key "$AGENT_IMAGE_ENV" BACKEND_IMAGE "$target_image_a"
      set_env_key "$AGENT_IMAGE_ENV" FRONTEND_IMAGE "$target_image_b"
      set_env_key "$AGENT_SOURCE_ENV" AGENT_SOURCE_DIR "$target_source"
      if ! assert_agent_compose_invariants \
          || ! agent_compose up -d --no-build mysql tool-executor-local tool-executor-standard \
            tool-executor-privileged backend frontend \
          || ! VERIFY_MIGRATION_MANIFEST_OVERRIDE="$target_migrations" verify_agent_stack \
          || ! all_service_configs_match agent mysql tool-executor-local tool-executor-standard \
            tool-executor-privileged backend frontend \
          || ! verify_running_ref lubinsun-test-backend-1 "$target_image_a" "$target_backend_digest" \
          || ! verify_running_ref lubinsun-test-frontend-1 "$target_image_b" "$target_frontend_digest"; then
        trap - EXIT INT TERM
        restore_agent_data_backup "$safety_backup" \
          || die "Agent 回滚验证失败，且 rollback-safety 恢复也失败；服务保持停机，安全备份为 $safety_backup"
        cp "$STATE_ROOT/backups/agent/$safety_backup/images.before" "$AGENT_IMAGE_ENV"
        cp "$STATE_ROOT/backups/agent/$safety_backup/source.before" "$AGENT_SOURCE_ENV"
        agent_compose up -d --no-build || true
        VERIFY_MIGRATION_MANIFEST_OVERRIDE="$BASELINE_MIGRATION_MANIFEST" verify_agent_stack || true
        die "Agent 回滚失败，已恢复回滚安全备份 $safety_backup"
      fi
      trap - EXIT INT TERM
      unset STOPPED_AGENT_BACKUP_DIR
      ;;
  esac
  if [[ "$component" != lubinsun-agent && "$component" != zenvis-analyzer ]]; then
    record_zenvis_head "rollback-$component" "$current_sha"
  fi
  if [[ -f "$previous" ]]; then
    temp=$(mktemp "$STATE_ROOT/components/$component/swap.XXXXXX")
    cp "$current" "$temp"
    cp "$previous" "$current"
    mv "$temp" "$previous"
    set_env_key "$current" config_digest "$(component_config_digest "$component")"
    local runtime_config_digest
    runtime_config_digest=$(component_runtime_config_digest "$component" || true)
    [[ -n "$runtime_config_digest" ]] \
      && set_env_key "$current" runtime_config_digest "$runtime_config_digest"
    if [[ "$component" == zenvis-analyzer ]]; then
      set_env_key "$current" zones_digest "$(sha256sum "$ANALYZER_ZONE_FILE" | awk '{print $1}')"
    fi
    set_env_key "$current" rollback_derived_from "$current_sha"
    log "回滚成功：component=$component sha=$(manifest_value "$current" sha)"
  else
    mv "$current" "$previous"
    log "回滚成功：component=$component，已恢复自动化接管前版本"
  fi
  reconcile_related_zenvis_manifests "$component"
  current="$STATE_ROOT/components/$component/current.env"
  SOURCE_REVISION=$(manifest_value "$current" sha)
  SOURCE_TREE=$(manifest_value "$current" source_tree)
  SOURCE_DIGEST=$(manifest_value "$current" source_digest)
  SOURCE_KIND=$(manifest_value "$current" source_kind)
  COMPONENT_SOURCE_DIR=$(manifest_value "$current" source_dir)
  AGENT_BACKEND_DIGEST=$(manifest_value "$current" agent_backend_digest)
  AGENT_FRONTEND_DIGEST=$(manifest_value "$current" agent_frontend_digest)
  AGENT_STACK_DIGEST=$(manifest_value "$current" agent_stack_digest)
  if [[ -f "$current" ]]; then
    component_runtime_matches "$component" || die "$component 回滚后实际配置与派生台账不一致"
    verify_component_runtime "$component" || die "$component 回滚后最终运行校验失败"
  fi
  write_verification "$component" rolled-back
  {
    printf 'component=%s\n' "$component"
    printf 'rolled_back_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } >"$STATE_ROOT/components/$component/rollback.once"
  chmod 600 "$STATE_ROOT/components/$component/rollback.once"
}

status() {
  local component current previous verification
  for component in zenvis zenvis-backend zenvis-frontend zenvis-analyzer plugin-lubinsun plugin-onesoc lubinsun-agent; do
    current="$STATE_ROOT/components/$component/current.env"
    previous="$STATE_ROOT/components/$component/previous.env"
    verification="$STATE_ROOT/components/$component/last-verification.env"
    printf '%-18s current=%-46s desired=%-64s actual=%s verified=%s/%s\n' "$component" \
      "$(manifest_value "$current" sha)" "$(manifest_value "$current" source_digest)" \
      "$(runtime_component_digest "$component")" \
      "$(manifest_value "$verification" revision)" "$(manifest_value "$verification" result)"
  done
  zenvis_compose ps -a
  agent_compose ps -a
  analyzer_compose ps -a
}

gc_state() {
  local keep=${1:-3} referenced backup_root source_root dir component file value kept
  local job_root="$STATE_ROOT/jobs" status_file log_file status_code
  [[ "$keep" =~ ^[0-9]+$ ]] && (( keep >= 1 && keep <= 20 )) \
    || die "gc 保留数量必须是 1..20"
  referenced=$(mktemp "$STATE_ROOT/gc-referenced.XXXXXX")
  trap 'rm -f "${referenced:-}"' RETURN
  for component in zenvis zenvis-backend zenvis-frontend zenvis-analyzer plugin-lubinsun plugin-onesoc lubinsun-agent; do
    for file in "$STATE_ROOT/components/$component/current.env" "$STATE_ROOT/components/$component/previous.env"; do
      [[ -f "$file" ]] || continue
      for value in "$(manifest_value "$file" backup_id)" \
        "$(manifest_value "$file" source_dir)" "$(manifest_value "$file" rollback_source_dir)"; do
        [[ -n "$value" ]] && printf '%s\n' "$value" >>"$referenced"
      done
    done
  done
  for file in "$ZENVIS_SOURCE_ENV" "$AGENT_SOURCE_ENV" "$ANALYZER_SOURCE_ENV"; do
    [[ -f "$file" ]] || continue
    sed -n 's/^[A-Z_]*SOURCE_DIR=//p' "$file" >>"$referenced"
  done

  for backup_root in "$STATE_ROOT/backups/zenvis" "$STATE_ROOT/backups/agent" "$STATE_ROOT/backups/analyzer"; do
    kept=0
    while IFS= read -r dir; do
      [[ -n "$dir" ]] || continue
      value=${dir##*/}
      if grep -Fxq "$value" "$referenced"; then
        continue
      fi
      if (( kept < keep )); then
        ((kept+=1))
        continue
      fi
      [[ -f "$dir/SHA256SUMS" ]] || { log "gc 跳过无校验清单目录：$dir"; continue; }
      (cd "$dir" && sha256sum -c SHA256SUMS >/dev/null) \
        || { log "gc 跳过校验失败目录：$dir"; continue; }
      [[ "$dir" == "$backup_root"/* ]] || die "gc 备份路径越界"
      rm -rf -- "$dir"
      log "gc 已删除未引用旧备份：$dir"
    done < <(find "$backup_root" -mindepth 1 -maxdepth 1 -type d \
      \( -name 'compose-*' -o -name 'agent-*' -o -name 'analyzer-*' \) -print | LC_ALL=C sort -r)
  done

  for component in zenvis zenvis-backend zenvis-frontend zenvis-analyzer plugin-lubinsun plugin-onesoc lubinsun-agent; do
    source_root="$STATE_ROOT/sources/$component"
    [[ -d "$source_root" ]] || continue
    kept=0
    while IFS= read -r dir; do
      [[ -n "$dir" ]] || continue
      if grep -Fxq "$dir" "$referenced"; then
        continue
      fi
      if (( kept < keep )); then
        ((kept+=1))
        continue
      fi
      [[ "$dir" =~ ^$source_root/[0-9a-f]{40}$ && -f "$dir/.snapshot-complete" ]] \
        || { log "gc 跳过异常源码目录：$dir"; continue; }
      rm -rf -- "$dir"
      log "gc 已删除未引用旧源码快照：$dir"
    done < <(find "$source_root" -mindepth 1 -maxdepth 1 -type d -name '[0-9a-f]*' \
      -printf '%T@ %p\n' | LC_ALL=C sort -nr | awk '{print $2}')
  done

  # SSH 入口先写日志、最后原子落盘 status。没有 status 的任务可能仍在运行，
  # 因此只清理日志与最终状态都存在、且退出码格式有效的已完成任务。
  if [[ -d "$job_root" ]]; then
    for component in zenvis zenvis-backend zenvis-frontend zenvis-analyzer lubinsun-agent; do
      kept=0
      while IFS= read -r status_file; do
        [[ -n "$status_file" ]] || continue
        log_file=${status_file%.status}.log
        [[ -f "$log_file" ]] || { log "gc 跳过缺少日志的任务状态：$status_file"; continue; }
        status_code=$(<"$status_file")
        [[ "$status_code" =~ ^[0-9]+$ && "$status_code" -le 255 ]] \
          || { log "gc 跳过状态异常的任务：$status_file"; continue; }
        if (( kept < keep )); then
          ((kept+=1))
          continue
        fi
        [[ "$status_file" == "$job_root/$component-"*.status \
          && "$log_file" == "$job_root/$component-"*.log ]] || die "gc 任务路径越界"
        rm -f -- "$log_file" "$status_file"
        log "gc 已删除旧部署任务日志：${status_file%.status}"
      done < <(find "$job_root" -mindepth 1 -maxdepth 1 -type f \
        -name "$component-*.status" -printf '%T@ %p\n' | LC_ALL=C sort -nr | awk '{print $2}')
    done
  fi
  rm -f "$referenced"
  trap - RETURN
}

verify_recorded_component() {
  local component=$1 current
  component_config "$component"
  current="$STATE_ROOT/components/$component/current.env"
  [[ -f "$current" ]] || die "$component 尚未被统一控制器接管"
  SOURCE_REVISION=$(manifest_value "$current" sha)
  SOURCE_TREE=$(manifest_value "$current" source_tree)
  SOURCE_DIGEST=$(manifest_value "$current" source_digest)
  SOURCE_KIND=$(manifest_value "$current" source_kind)
  COMPONENT_SOURCE_DIR=$(manifest_value "$current" source_dir)
  AGENT_BACKEND_DIGEST=$(manifest_value "$current" agent_backend_digest)
  AGENT_FRONTEND_DIGEST=$(manifest_value "$current" agent_frontend_digest)
  AGENT_STACK_DIGEST=$(manifest_value "$current" agent_stack_digest)
  MIGRATION_SET_DIGEST=$(manifest_value "$current" migration_set_digest)
  MIGRATION_MANIFEST=$(manifest_value "$current" migration_manifest)
  [[ -n "$SOURCE_DIGEST" ]] || die "$component 的旧台账没有内容摘要，请先执行一次 deploy-local"
  component_runtime_matches "$component" || die "$component 运行版本与部署台账不一致"
  verify_component_runtime "$component" || die "$component 运行校验失败"
  write_verification "$component" verified
  log "运行版本校验通过：component=$component revision=$SOURCE_REVISION digest=$SOURCE_DIGEST"
}

verify_recorded() {
  local requested=$1 component
  if [[ "$requested" != all ]]; then
    verify_recorded_component "$requested"
    return
  fi
  for component in zenvis zenvis-backend zenvis-frontend zenvis-analyzer lubinsun-agent; do
    verify_recorded_component "$component"
  done
}

main() {
  local action=${1:-}
  ensure_state
  case "$action" in
    doctor) doctor ;;
    status) doctor; status ;;
    verify)
      [[ $# -eq 2 ]] || { usage; exit 2; }
      exec 9>"$LOCK_FILE"
      flock -w 1800 9 || die "等待跨仓库部署锁超时"
      doctor
      verify_recorded "$2"
      ;;
    deploy)
      [[ $# -eq 4 ]] || { usage; exit 2; }
      exec 9>"$LOCK_FILE"
      flock -w 1800 9 || die "等待跨仓库部署锁超时"
      deploy_locked "$2" "$3" "$4"
      ;;
    deploy-local)
      [[ $# -eq 2 ]] || { usage; exit 2; }
      exec 9>"$LOCK_FILE"
      flock -w 1800 9 || die "等待跨仓库部署锁超时"
      deploy_local_locked "$2"
      ;;
    rollback)
      [[ $# -eq 2 ]] || { usage; exit 2; }
      exec 9>"$LOCK_FILE"
      flock -w 1800 9 || die "等待跨仓库部署锁超时"
      doctor
      rollback_locked "$2"
      ;;
    gc)
      [[ $# -le 2 ]] || { usage; exit 2; }
      exec 9>"$LOCK_FILE"
      flock -w 1800 9 || die "等待跨仓库部署锁超时"
      gc_state "${2:-3}"
      ;;
    *) usage; exit 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
