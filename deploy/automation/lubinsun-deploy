  mkdir "$backup_dir" || die "Analyzer 备份 ID 冲突：$backup_id"
  image=$(env_value "$ANALYZER_IMAGE_ENV" ANALYZER_IMAGE)
  [[ -n "$image" ]] || die "无法识别现有 Analyzer 镜像"
  cp "$ANALYZER_ENV" "$backup_dir/topology.env.before"
  cp "$ANALYZER_ZONE_FILE" "$backup_dir/zones.json.before"
  cp "$ANALYZER_IMAGE_ENV" "$backup_dir/images.before"
  cp "$ANALYZER_SOURCE_ENV" "$backup_dir/source.before"
  analyzer_compose config >"$backup_dir/compose-config.yml"
  docker image inspect "$image" >"$backup_dir/image-inspect.json"
  sha256sum "$backup_dir/topology.env.before" "$backup_dir/zones.json.before" \
    "$backup_dir/images.before" "$backup_dir/source.before" "$backup_dir/compose-config.yml" \
    "$backup_dir/image-inspect.json" >"$backup_dir/SHA256SUMS"
  chmod -R go-rwx "$backup_dir"
  CREATED_BACKUP_ID="$backup_id"
}

write_manifest() {
  local component=$1 sha=$2 repository=$3 image_a=${4:-} image_b=${5:-} backup_id=${6:-}
  local rollback_image_a=${7:-} rollback_image_b=${8:-}
  local rollback_source_dir=${9:-} dir current previous temp release_key config_digest runtime_config_digest
  local image_id_a image_id_b zones_digest
  dir="$STATE_ROOT/components/$component"
  current="$dir/current.env"
  previous="$dir/previous.env"
  mkdir -p "$dir/releases"
  [[ -f "$current" ]] && cp "$current" "$previous"
  release_key=${sha//[^A-Za-z0-9_.-]/_}
  temp=$(mktemp "$dir/releases/${release_key}.XXXXXX")
  config_digest=$(component_config_digest "$component")
  runtime_config_digest=$(component_runtime_config_digest "$component" || true)
  [[ -n "$image_a" ]] && image_id_a=$(docker image inspect --format '{{.Id}}' "$image_a" 2>/dev/null || true)
  [[ -n "$image_b" ]] && image_id_b=$(docker image inspect --format '{{.Id}}' "$image_b" 2>/dev/null || true)
  [[ "$component" == zenvis-analyzer ]] && zones_digest=$(sha256sum "$ANALYZER_ZONE_FILE" | awk '{print $1}')
  {
    printf 'component=%s\n' "$component"
    printf 'repository=%s\n' "$repository"
    printf 'sha=%s\n' "$sha"
    printf 'source_tree=%s\n' "${SOURCE_TREE:-}"
    printf 'source_digest=%s\n' "${SOURCE_DIGEST:-}"
    printf 'source_kind=%s\n' "${SOURCE_KIND:-}"
    printf 'source_dir=%s\n' "${COMPONENT_SOURCE_DIR:-}"
    printf 'agent_backend_digest=%s\n' "${AGENT_BACKEND_DIGEST:-}"
    printf 'agent_frontend_digest=%s\n' "${AGENT_FRONTEND_DIGEST:-}"
    printf 'agent_stack_digest=%s\n' "${AGENT_STACK_DIGEST:-}"
    printf 'migration_set_digest=%s\n' "${MIGRATION_SET_DIGEST:-}"
    printf 'migration_manifest=%s\n' "${MIGRATION_MANIFEST:-}"
    printf 'config_digest=%s\n' "${config_digest:-}"
    printf 'runtime_config_digest=%s\n' "${runtime_config_digest:-}"
    printf 'zones_digest=%s\n' "${zones_digest:-}"
    printf 'image_a=%s\n' "$image_a"
    printf 'image_b=%s\n' "$image_b"
    printf 'image_id_a=%s\n' "${image_id_a:-}"
    printf 'image_id_b=%s\n' "${image_id_b:-}"
    printf 'backup_id=%s\n' "$backup_id"
    printf 'rollback_image_a=%s\n' "$rollback_image_a"
    printf 'rollback_image_b=%s\n' "$rollback_image_b"
    printf 'rollback_source_dir=%s\n' "$rollback_source_dir"
    printf 'deployed_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$dir/releases/$release_key.env"
  cp "$dir/releases/$release_key.env" "$current"
}
record_zenvis_head() {
  local component=$1 sha=$2 temp
  temp=$(mktemp "${ZENVIS_RELEASE_HEAD}.XXXXXX")
  {
    printf 'component=%s\n' "$component"
    printf 'sha=%s\n' "$sha"
    printf 'updated_at=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } >"$temp"
  chmod 600 "$temp"
  mv "$temp" "$ZENVIS_RELEASE_HEAD"
}

assert_latest_zenvis_release() {
  local component=$1 sha=$2 head_component head_sha
  head_component=$(manifest_value "$ZENVIS_RELEASE_HEAD" component)
  head_sha=$(manifest_value "$ZENVIS_RELEASE_HEAD" sha)
  [[ "$head_component" == "$component" && "$head_sha" == "$sha" ]] || {
    die "拒绝恢复过期的一致性备份：最新 ZenVis 变更是 ${head_component:-unknown}@${head_sha:-unknown}"
  }
}


